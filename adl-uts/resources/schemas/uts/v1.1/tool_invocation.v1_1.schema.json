{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/agent-logic/universal-tool-schema/main/schemas/uts/v1.1/tool_invocation.v1_1.schema.json",
  "title": "UTS Tool Invocation Metadata v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "invocation_id",
    "caller",
    "tool",
    "intent",
    "purpose",
    "side_effect_expectations",
    "replay_safety",
    "observability"
  ],
  "properties": {
    "invocation_id": { "type": "string", "minLength": 1 },
    "caller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["model", "agent", "human", "service"] },
        "id": { "type": "string" }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "intent": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "side_effect_expectations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["none", "local_state", "external_state", "irreversible", "human_visible", "governance_relevant"]
      },
      "uniqueItems": true
    },
    "replay_safety": {
      "type": "string",
      "enum": ["replay_safe", "replay_requires_approval", "not_replay_safe"]
    },
    "observability": {
      "type": "string",
      "enum": ["none", "basic", "full", "governance"]
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retryable": { "type": "boolean" },
        "max_attempts": { "type": "integer", "minimum": 0 }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^x-(?!.*(?:authority|grant|execute|permission))[a-z0-9._-]+$"
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "side_effect_expectations": {
            "contains": { "const": "none" }
          }
        }
      },
      "then": {
        "properties": {
          "side_effect_expectations": {
            "maxItems": 1
          }
        }
      }
    }
  ]
}
