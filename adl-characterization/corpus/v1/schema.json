{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-design-language.dev/schemas/characterization-corpus-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "incumbent_revision", "binary_sha256", "repetitions", "schema_path", "required_behaviors", "cases", "equivalence_groups", "difference_groups", "coverage"],
  "properties": {
    "schema": {"const": "adl.characterization.corpus.v1"},
    "incumbent_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repetitions": {"type": "integer", "minimum": 3},
    "schema_path": {"type": "string", "minLength": 1},
    "required_behaviors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}},
    "equivalence_groups": {"type": "array", "items": {"$ref": "#/$defs/group"}},
    "difference_groups": {"type": "array", "items": {"$ref": "#/$defs/group"}},
    "coverage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/coverage"}}
  },
  "$defs": {
    "stringArray": {"type": "array", "items": {"type": "string"}},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "behaviors", "steps"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "behaviors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
        "normalization": {"type": "array", "items": {"$ref": "#/$defs/normalization"}}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "args", "expected_exit"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "args": {"$ref": "#/$defs/stringArray"},
        "expected_exit": {"type": "integer"},
        "stdout_contains": {"$ref": "#/$defs/stringArray"},
        "stderr_contains": {"$ref": "#/$defs/stringArray"},
        "pre_actions": {"type": "array", "items": {"$ref": "#/$defs/preAction"}}
      }
    },
    "preAction": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "private_path", "public_path", "seed_byte"],
          "properties": {"kind": {"const": "fixed_ed25519_keypair"}, "private_path": {"type": "string"}, "public_path": {"type": "string"}, "seed_byte": {"type": "integer", "minimum": 0, "maximum": 255}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "path", "from", "to"],
          "properties": {"kind": {"const": "replace_text"}, "path": {"type": "string"}, "from": {"type": "string", "minLength": 1}, "to": {"type": "string"}}
        }
      ]
    },
    "normalization": {
      "oneOf": [
        {"$ref": "#/$defs/basicNormalization"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "step", "stream", "fields"],
          "properties": {"kind": {"const": "replace_json_fields"}, "step": {"type": "string"}, "stream": {"enum": ["stdout", "stderr"]}, "fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "step", "stream", "line"],
          "properties": {"kind": {"const": "remove_exact_line"}, "step": {"type": "string"}, "stream": {"enum": ["stdout", "stderr"]}, "line": {"type": "string", "minLength": 1}}
        }
      ]
    },
    "basicNormalization": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "step", "stream"],
      "properties": {"kind": {"enum": ["canonical_json", "replace_root", "replace_workdir"]}, "step": {"type": "string"}, "stream": {"enum": ["stdout", "stderr"]}}
    },
    "group": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "cases"],
      "properties": {"id": {"type": "string", "minLength": 1}, "cases": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}}}
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["behavior", "cases"],
      "properties": {"behavior": {"type": "string", "minLength": 1}, "cases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}
    }
  }
}
