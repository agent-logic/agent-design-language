flowchart LR
  A["Concrete MembershipState plus AuthorityMembership"] --> P["Commit PrepareAuthorityIntent"]
  C["Canonical quorum-attested time"] --> P
  P --> E["Opaque local VoterEndorsementAuthority"]
  E --> F["Commit FinalizeAuthorityIntent with strict current quorum"]
  F --> J["Exclusive bounded canonical protocol journal"]
  J --> X["External ConsensusCheckpointAuthority CAS and reconcile"]
  X --> R["Durable exact-result and retry cache"]
  R --> T["Opaque VerifiedAuthorityOperation token"]
  T --> M["#199 governed membership coordinator"]
  T --> S["#200 concrete authority-store reconciler"]
  L["Legacy direct authority command"] --> D["Versioned migration or fail-closed rejection"]
  J -. "crash, rollback, conflict, or ambiguity" .-> Z["Fail closed; reconcile only the exact operation"]
