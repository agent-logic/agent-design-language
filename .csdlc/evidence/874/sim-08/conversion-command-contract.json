  "supported_scope": "copied_record_conversion_only",
  "live_request_contract": "absent",
  "commands": [
    "convert --request FILE",
    "operation-evidence --request FILE",
    "restore-pre-effect --request FILE",
    "status --git-common PATH --repository OWNER/REPO --issue N",
    "validate --git-common PATH --repository OWNER/REPO --issue N"
  ],
  "fence_owner": "convert starts writer-fence-guardian internally; no operator-authored guardian request",
  "live_activation_ready": false,
  "p2_disposition": "documentation ambiguity corrected; live-execution requirement unresolved",
  "required_inputs": {
    "schema": "csdlc.v3.copied_record_conversion.v1",
    "repository": "agent-logic/agent-design-language",
    "operation_id": "new nonempty identifier; unchanged across restart/evidence/restore",
    "git_common": "canonical absolute Git common directory of isolated repository",
    "linked_worktree": "canonical registered non-primary isolated worktree root",
    "linked_branch": "actual symbolic-ref --quiet --short HEAD of linked_worktree",
    "linked_head": "actual rev-parse HEAD of linked_worktree",
    "registry_path": "linked_worktree/docs/templates/prompts/current.json",
    "authority_bytes_path": "linked_worktree/csdlc-v3/operator/authority-selector.json",
    "prior_executable_path": "canonical regular-file copy of prior executable",
    "prior_executable_blake3": "BLAKE3 of actual prior executable bytes",
    "writer_fence_issues": "unique nonzero IDs exactly equal to record issue IDs union writer_probe_issue",
    "writer_probe_issue": "nonzero retained isolated old-writer probe issue ID",
    "records": "exactly seven objects with role, unique numeric issue, absolute copied source directory containing native index/cards/evidence"
  },
  "record_roles_in_order": [
    "prepared",
    "bound_dirty",
    "implemented",
    "reviewed",
    "published",
    "terminal",
    "pending_recovery"
  ],
  "optional_inputs": {
    "writer_fence_probe": "false unless driven by SIM06 authenticated probe handshake",
    "fault_injection": "omit; test-only fault object, never activation authority"
  },
  "native_adoption": {
    "binary": "csdlc",
    "command": "prepare ISSUE --plan PLAN --repo-root CHECKOUT --json",
    "scope": "admitted ready/bound legacy records; no global conversion or snapshot rollback",
    "recovery": "recover ISSUE --repo-root CHECKOUT --json then only classified recovery with fresh --execute --preview DIGEST"
  },
  "request_builder": {
    "path": "conversion_request.py",
    "input_scope": "retained SIM06 seven-record census in a new isolated repository",
    "lifecycle_effects": false,
    "native_admission": "deferred to converter preflight",
