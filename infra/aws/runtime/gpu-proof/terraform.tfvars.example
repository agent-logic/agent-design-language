aws_account_id = "<agent-logic-aws-account-id>"
aws_profile    = "agent-logic-admin"
aws_region     = "us-west-2"
run_id        = "adl-issue345-20260901-013000"
owner_token   = "0123456789abcdef0123456789abcdef"

runtime_ami_id = "ami-0123456789abcdef0"
gpu_ami_id     = "ami-0123456789abcdef0"
vpc_id         = "vpc-0123456789abcdef0"
subnet_id      = "subnet-0123456789abcdef0"

runtime_instance_type = "r7i.2xlarge"
gpu_instance_type     = "g6.xlarge"
detailed_monitoring   = false

ssh_ingress_cidr = "203.0.113.10/32"
ssh_public_key    = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleReplaceWithOperatorPublicKey issue345"

runtime_root_volume_size_gib         = 80
runtime_root_volume_iops             = 3000
runtime_root_volume_throughput_mibps = 125
gpu_root_volume_size_gib             = 200
gpu_root_volume_iops                 = 3000
gpu_root_volume_throughput_mibps     = 125

authorized_max_hourly_usd = 1.50
authorized_max_total_usd  = 21

artifact_bucket = "example-versioned-artifact-bucket"
artifact_prefix = "shepherd/"
artifact_read_keys = [
  "shepherd/issue-345/two-model/artifact-manifest.json",
  "shepherd/runtime/ollama/0.31.1/ollama-linux-amd64.tar.zst",
  "shepherd/runtime/rustup/1.28.2/rustup-init-x86_64-unknown-linux-gnu",
  "shepherd/runs/adl-issue345-example/source.tar",
  "shepherd/runs/adl-issue345-example/config.json",
  "shepherd/runs/adl-issue345-example/gpu-bootstrap.sh",
  "shepherd/runs/adl-issue345-example/runtime-bootstrap.sh"
]

gpu_user_data = <<-EOT
  #!/bin/bash
  set -euo pipefail
  # Start Ollama on 0.0.0.0:11434 and load at least two models.
EOT

runtime_user_data = <<-EOT
  #!/bin/bash
  set -euo pipefail
  export OLLAMA_HOST="http://__GPU_PRIVATE_IP__:11434"
  # Start Guardian, Runtime, six agents, UTS, ACC, and Freedom Gate.
EOT
