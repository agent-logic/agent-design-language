#!/bin/bash
set -Eeuo pipefail
export HOME=/root
start_uptime="$(cut -d' ' -f1 /proc/uptime)"
state=/var/lib/adl/issue607-runtime
repo_runtime="$state/repo"
mkdir -p "$state" /mnt/adl-warm-runtime
# Independent cost failsafe. EC2 is configured to terminate on guest shutdown.
systemd-run --unit=adl-issue607-budget-shutdown --on-active=8m /sbin/shutdown -h now

s3_get() {
  python3 - "$1" "$2" "$3" "$4" <<'PY'
import pathlib, sys, boto3
region, bucket, key, destination = sys.argv[1:]
target = pathlib.Path(destination)
temporary = target.with_suffix(target.suffix + ".partial")
boto3.client("s3", region_name=region).download_file(bucket, key, str(temporary))
temporary.replace(target)
PY
}
s3_put() {
  python3 - "$1" "$2" "$3" "$4" <<'PY'
import pathlib, sys, boto3
region, bucket, key, source = sys.argv[1:]
client = boto3.client("s3", region_name=region)
client.meta.events.register(
    "before-sign.s3.PutObject",
    lambda request, **kwargs: request.headers.__setitem__("If-None-Match", "*"),
)
client.put_object(Bucket=bucket, Key=key, Body=pathlib.Path(source).read_bytes())
PY
}

failure() {
  rc=$?
  jq -n --arg run_id '${run_id}' --argjson rc "$rc" '{schema:"adl.issue607.runtime_local_ready.v1",status:"failed",run_id:$run_id,exit_code:$rc}' >"$state/failure.json" 2>/dev/null || true
  s3_put '${region}' '${artifact_bucket}' '${runtime_ready_key}' "$state/failure.json" >/dev/null 2>&1 || true
  exit "$rc"
}
trap failure EXIT

for command in curl jq mount openssl python3 readlink socat systemctl veritysetup; do command -v "$command" >/dev/null; done
python3 -c 'import boto3, botocore' >/dev/null
compact='${volume_id}'
compact="$${compact//-/}"
while true; do
  device="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$compact"
  [[ -e "$device" ]] && break
  sleep 1
done
device="$(readlink -f "$device")"
veritysetup open "$${device}p1" adl-warm-runtime "$${device}p2" '${root_hash}'
mount -o ro,nosuid,nodev /dev/mapper/adl-warm-runtime /mnt/adl-warm-runtime
mkdir -p "$repo_runtime" "$state/repo-upper" "$state/repo-work"
mount -t overlay overlay \
  -o "lowerdir=/mnt/adl-warm-runtime/repo,upperdir=$state/repo-upper,workdir=$state/repo-work" \
  "$repo_runtime"
manifest=/mnt/adl-warm-runtime/sealed-volume-manifest.json
jq -e --arg volume '${volume_id}' --arg generation '${artifact_generation}' --arg commit '${source_commit}' \
  '.schema=="adl.issue607.sealed_volume_manifest.v1" and .node=="runtime" and .volume_id==$volume and .artifact_generation==$generation and .source_commit==$commit' "$manifest" >/dev/null
image_id="$(curl -fsS -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' http://169.254.169.254/latest/api/token | xargs -I TOKEN curl -fsS -H 'X-aws-ec2-metadata-token: TOKEN' http://169.254.169.254/latest/meta-data/ami-id)"
instance_id="$(curl -fsS -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' http://169.254.169.254/latest/api/token | xargs -I TOKEN curl -fsS -H 'X-aws-ec2-metadata-token: TOKEN' http://169.254.169.254/latest/meta-data/instance-id)"
live_facility="$(jq -n --arg kernel "$(uname -r)" --arg libc "$(ldd --version 2>&1 | head -1)" \
  --arg boto3 "$(python3 -c 'import boto3; print(boto3.__version__)')" '{kernel:$kernel,libc:$libc,boto3:$boto3}')"
jq -e --argjson live "$live_facility" '.facility_inventory.measured_after_preparation_bootstrap==true and (.facility_inventory|{kernel,libc,boto3})==($live|{kernel,libc,boto3})' "$manifest" >/dev/null

export OLLAMA_HOST='http://${gpu_private_ip}:11434'
runtime_state=/var/lib/adl/issue607-runtime-template
rm -rf "$runtime_state"
mkdir -p "$runtime_state"
cp -a /mnt/adl-warm-runtime/install/runtime-state/. "$runtime_state/"
init="$runtime_state/runtime-init.toml"
sed -i 's#^sntp_server = .*#sntp_server = "169.254.169.123"#' "$init"
systemd-run --unit=adl-runtime-guardian \
  --property=Restart=always \
  --property=RestartSec=1s \
  --property=StartLimitIntervalSec=0 \
  /bin/bash -c 'find "$1" -type f -name "*.lock" -delete; exec "$2" --init "$3"' \
  _ "$runtime_state" /mnt/adl-warm-runtime/target/debug/adl-runtime-guardian "$init"
until python3 "$repo_runtime/adl/tools/issue607_probe_runtime.py" \
  --init "$init" --state-root "$runtime_state" --output "$state/running-transport-proof.json" --timeout-seconds 15
do
  sleep 1
done
jq -e '.status=="pass" and .authenticated_https==true and .authenticated_wss==true' "$state/running-transport-proof.json" >/dev/null
end_uptime="$(cut -d' ' -f1 /proc/uptime)"
elapsed="$(awk -v start="$start_uptime" -v end="$end_uptime" 'BEGIN {printf "%.3f", end-start}')"
jq -n --arg run_id '${run_id}' --arg instance_id "$instance_id" --arg volume_id '${volume_id}' --arg generation '${artifact_generation}' --arg root_hash '${root_hash}' --arg elapsed "$elapsed" \
  --arg transport_proof_sha256 "$(sha256sum "$state/running-transport-proof.json" | awk '{print $1}')" \
  '{schema:"adl.issue607.runtime_local_ready.v1",status:"ready",run_id:$run_id,instance_id:$instance_id,volume_id:$volume_id,clock_source:"CLOCK_BOOTTIME_linux_proc_uptime",local_ready_seconds:($elapsed|tonumber),artifact_generation:$generation,dm_verity_root_hash:$root_hash,guardian_supervised:true,runtime_ready:true,authenticated_https:true,authenticated_wss:true,running_transport_proof_sha256:$transport_proof_sha256}' >"$state/ready.json"
s3_put '${region}' '${artifact_bucket}' '${runtime_ready_key}' "$state/ready.json"
trap - EXIT

until
  s3_get '${region}' '${artifact_bucket}' '${gpu_ready_key}' "$state/gpu-ready.json" >/dev/null 2>&1 \
    && jq -e --arg run '${run_id}' --arg volume '${gpu_volume_id}' --arg generation '${artifact_generation}' --arg root '${gpu_root_hash}' '.status=="ready" and .run_id==$run and .volume_id==$volume and .artifact_generation==$generation and .dm_verity_root_hash==$root and .model_count>=2 and .multi_model_residency=="passed" and .ollama_public==false' "$state/gpu-ready.json" >/dev/null \
    && curl -fsS 'http://${gpu_private_ip}:11434/api/ps' >/dev/null
do
  sleep 0.25
done

systemd-run --unit=adl-issue607-ollama-tunnel \
  --property=Restart=always \
  --property=RestartSec=1s \
  --property=StartLimitIntervalSec=0 \
  /usr/bin/socat TCP-LISTEN:11434,bind=127.0.0.1,reuseaddr,fork TCP:${gpu_private_ip}:11434
until curl -fsS http://127.0.0.1:11434/api/tags >/dev/null; do sleep 0.25; done

guardian_evidence="$repo_runtime/.adl/runtime-v3/qualification-issue607"
mkdir -p "$guardian_evidence"
export ADL_RUNTIME_USE_PREBUILT_BINARIES=1
export ADL_RUNTIME_SOURCE_REVISION='${source_commit}'
export ADL_RUNTIME_GUARDIAN_EVIDENCE_ROOT="$guardian_evidence"
export ADL_RUNTIME_GUARDIAN_TARGET_ROOT=/mnt/adl-warm-runtime
export CARGO_TARGET_DIR=/mnt/adl-warm-runtime/target
export ADL_RUNTIME_VECTOR_BIN=/mnt/adl-warm-runtime/vector/bin/vector
bash "$repo_runtime/adl/tools/validate_v092_runtime_guardian_lifecycle.sh" --suite preflight_1x >"$state/guardian-validation.log" 2>&1
ADL_ISSUE607_AWS_REGION='${region}' \
ADL_ISSUE607_ARTIFACT_BUCKET='${artifact_bucket}' \
ADL_ISSUE607_QUALIFICATION_KEY='${qualification_key}' \
ADL_ISSUE607_SOURCE_COMMIT='${source_commit}' \
ADL_ISSUE607_GPU_PRIVATE_IP=127.0.0.1 \
ADL_ISSUE607_RUN_ID='${run_id}' \
ADL_ISSUE607_GUARDIAN_EVIDENCE_ROOT="$guardian_evidence" \
  bash "$repo_runtime/adl/tools/issue607_qualify_warm_polis.sh"
