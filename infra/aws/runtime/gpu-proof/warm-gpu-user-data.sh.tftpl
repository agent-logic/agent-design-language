#!/bin/bash
set -Eeuo pipefail
export HOME=/root
start_uptime="$(cut -d' ' -f1 /proc/uptime)"
state=/var/lib/adl/issue607-gpu
mkdir -p "$state" /mnt/adl-warm-gpu

s3_put() {
  python3 - "$1" "$2" "$3" "$4" <<'PY'
import pathlib, sys, boto3
region, bucket, key, source = sys.argv[1:]
boto3.client("s3", region_name=region).put_object(Bucket=bucket, Key=key, Body=pathlib.Path(source).read_bytes(), IfNoneMatch="*")
PY
}

failure() {
  rc=$?
  jq -n --arg run_id '${run_id}' --argjson rc "$rc" '{schema:"adl.issue607.gpu_local_ready.v1",status:"failed",run_id:$run_id,exit_code:$rc}' >"$state/failure.json" 2>/dev/null || true
  s3_put '${region}' '${artifact_bucket}' '${ready_key}' "$state/failure.json" >/dev/null 2>&1 || true
  exit "$rc"
}
trap failure EXIT

for command in curl jq mount python3 readlink systemctl veritysetup nvidia-smi; do command -v "$command" >/dev/null; done
python3 -c 'import boto3, botocore' >/dev/null
compact='${volume_id}'
compact="$${compact//-/}"
while true; do
  device="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$compact"
  [[ -e "$device" ]] && break
  sleep 1
done
device="$(readlink -f "$device")"
veritysetup open "$${device}p1" adl-warm-gpu "$${device}p2" '${root_hash}'
mount -o ro,nosuid,nodev /dev/mapper/adl-warm-gpu /mnt/adl-warm-gpu
manifest=/mnt/adl-warm-gpu/sealed-volume-manifest.json
jq -e --arg volume '${volume_id}' --arg generation '${artifact_generation}' --arg commit '${source_commit}' \
  '.schema=="adl.issue607.sealed_volume_manifest.v1" and .node=="gpu" and .volume_id==$volume and .artifact_generation==$generation and .source_commit==$commit and (.models|length)>=2' "$manifest" >/dev/null
image_id="$(curl -fsS -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' http://169.254.169.254/latest/api/token | xargs -I TOKEN curl -fsS -H 'X-aws-ec2-metadata-token: TOKEN' http://169.254.169.254/latest/meta-data/ami-id)"
instance_id="$(curl -fsS -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' http://169.254.169.254/latest/api/token | xargs -I TOKEN curl -fsS -H 'X-aws-ec2-metadata-token: TOKEN' http://169.254.169.254/latest/meta-data/instance-id)"
live_facility="$(jq -n --arg kernel "$(uname -r)" --arg libc "$(ldd --version 2>&1 | head -1)" \
  --arg nvidia_driver "$(nvidia-smi --query-gpu=driver_version --format=csv,noheader | head -1)" \
  --arg cuda "$(nvidia-smi | sed -n 's/.*CUDA Version: \([0-9.]*\).*/\1/p' | head -1)" \
  --arg gpu "$(nvidia-smi --query-gpu=name --format=csv,noheader | head -1)" \
  --arg boto3 "$(python3 -c 'import boto3; print(boto3.__version__)')" \
  '{kernel:$kernel,libc:$libc,nvidia_driver:$nvidia_driver,cuda:$cuda,gpu:$gpu,boto3:$boto3}')"
jq -e --argjson live "$live_facility" '.facility_inventory.measured_after_preparation_bootstrap==true and (.facility_inventory|{kernel,libc,nvidia_driver,cuda,gpu,boto3})==$live' "$manifest" >/dev/null

model_count="$(jq '.models|length' "$manifest")"
systemd-run --unit=adl-ollama \
  --property=Restart=always \
  --property=RestartSec=1s \
  --property=StartLimitIntervalSec=0 \
  --setenv=HOME="$state" --setenv=OLLAMA_MODELS=/mnt/adl-warm-gpu/install/models/models \
  --setenv=OLLAMA_HOST=0.0.0.0:11434 --setenv=OLLAMA_KEEP_ALIVE=-1 \
  --setenv=OLLAMA_MAX_LOADED_MODELS="$model_count" \
  /mnt/adl-warm-gpu/install/bin/ollama serve
until curl -fsS http://127.0.0.1:11434/api/version >/dev/null; do sleep 0.25; done
while read -r model; do
  until jq -n --arg model "$model" '{model:$model,prompt:"Reply OK.",stream:false,keep_alive:-1,options:{num_predict:1}}' \
    | curl --max-time 300 -fsS http://127.0.0.1:11434/api/generate -d @- >/dev/null
  do
    sleep 1
  done
done < <(jq -r '.models[].model_identity' "$manifest")
models="$(curl -fsS http://127.0.0.1:11434/api/ps | jq -ce --argjson expected "$(jq -c '.models|sort_by(.model_identity)' "$manifest")" '
  [.models[]|{model_identity:.name,model_digest_sha256:(.digest|sub("^sha256:";"")),size_vram:.size_vram}]|sort_by(.model_identity)
  |select(length==($expected|length))|select(all(.[];.size_vram>0))
  |select(map({model_identity,model_digest_sha256})==$expected)')"
end_uptime="$(cut -d' ' -f1 /proc/uptime)"
elapsed="$(awk -v start="$start_uptime" -v end="$end_uptime" 'BEGIN {printf "%.3f", end-start}')"
jq -n --arg run_id '${run_id}' --arg instance_id "$instance_id" --arg volume_id '${volume_id}' --arg generation '${artifact_generation}' --arg root_hash '${root_hash}' --arg elapsed "$elapsed" --argjson models "$models" \
  '{schema:"adl.issue607.gpu_local_ready.v1",status:"ready",run_id:$run_id,instance_id:$instance_id,volume_id:$volume_id,clock_source:"CLOCK_BOOTTIME_linux_proc_uptime",local_ready_seconds:($elapsed|tonumber),artifact_generation:$generation,dm_verity_root_hash:$root_hash,models:$models,model_count:($models|length),multi_model_residency:"passed",ollama_public:false}' >"$state/ready.json"
s3_put '${region}' '${artifact_bucket}' '${ready_key}' "$state/ready.json"
trap - EXIT
