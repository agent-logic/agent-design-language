#!/usr/bin/env bash
set -Eeuo pipefail

# Legacy local Observatory helper. Permanent Runtime v3 lifecycle control is
# owned by the current-generation Rust `csm runtime-v3` command.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="${ADL_CSM_REPO_ROOT:-$SCRIPT_DIR}"
GIT_COMMON_DIR="$(git -C "$REPO_ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
PRIMARY_REPO_ROOT="$REPO_ROOT"
if [[ -n "$GIT_COMMON_DIR" && -d "$GIT_COMMON_DIR" ]]; then
  PRIMARY_REPO_ROOT="$(cd "$(dirname "$GIT_COMMON_DIR")" && pwd)"
fi
if [[ ! -d "$PRIMARY_REPO_ROOT/.adl" ]]; then
  PRIMARY_REPO_ROOT="$(git -C "$REPO_ROOT" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$REPO_ROOT")"
fi

CSM_RUNTIME_BIN="$PRIMARY_REPO_ROOT/.adl/runtime-v3/current/bin/csm"
CSM_RUNTIME_INIT="$PRIMARY_REPO_ROOT/.adl/runtime-v3/live/runtime-init.toml"

legacy_runtime_control_refusal() {
  local command="${1:-default}"
  printf '%s\n' \
    "CSMctl status=failed reason=legacy_runtime_control_removed command=$command" \
    "Use: \"$CSM_RUNTIME_BIN\" runtime-v3 <start|stop|status|reload> --init \"$CSM_RUNTIME_INIT\" --json" >&2
  exit 2
}

case "${1-}" in
  ""|open|start|up|restart|status|stop|logs|urls|rotate-continuity-state)
    legacy_runtime_control_refusal "${1:-default}"
    ;;
esac

SERVICE_ROOT="$REPO_ROOT"
if [[ ! -d "$SERVICE_ROOT/.adl/runtime-v3-service" && -d "$PRIMARY_REPO_ROOT/.adl/runtime-v3-service" ]]; then
  SERVICE_ROOT="$PRIMARY_REPO_ROOT"
fi
BIN_ROOT="$REPO_ROOT"
if [[ ! -x "$BIN_ROOT/.adl/bin/adl-runtime-kernel" && -x "$PRIMARY_REPO_ROOT/.adl/bin/adl-runtime-kernel" ]]; then
  BIN_ROOT="$PRIMARY_REPO_ROOT"
fi

SERVICE_DIR="${ADL_CSM_SERVICE_DIR:-$SERVICE_ROOT/.adl/runtime-v3-service}"
CONFIG_FILE="${ADL_CSM_CONFIG_FILE:-$SERVICE_DIR/CSMctl.conf}"
if [[ ! -f "$CONFIG_FILE" && -f "$SERVICE_DIR/start_CSM.conf" ]]; then
  CONFIG_FILE="$SERVICE_DIR/start_CSM.conf"
fi
if [[ -f "$CONFIG_FILE" ]]; then
  # shellcheck source=/dev/null
  . "$CONFIG_FILE"
fi
ENV_FILE="${ADL_CSM_ENV_FILE:-$SERVICE_DIR/runtime.env}"
STATE_DIR="${ADL_CSM_STATE_DIR:-$SERVICE_DIR/state}"
GENERATED_DIR="${ADL_CSM_GENERATED_DIR:-$SERVICE_DIR/generated}"
GENERATED_BIN_DIR="${ADL_CSM_GENERATED_BIN_DIR:-$GENERATED_DIR/bin}"
STATE_TLS_DIR="${ADL_CSM_STATE_TLS_DIR:-$STATE_DIR/tls}"
CREDENTIAL_DIR="${ADL_CSM_CREDENTIAL_DIR:-$STATE_DIR/credentials}"
CONTINUITY_ROOT="${ADL_CSM_CONTINUITY_ROOT:-$STATE_DIR/private-continuity}"
CONTINUITY_HISTORY_ROOT="${ADL_CSM_CONTINUITY_HISTORY_ROOT:-$STATE_DIR/continuity}"
QUARANTINE_DIR="${ADL_CSM_QUARANTINE_DIR:-$STATE_DIR/quarantine}"
RUNTIME_PORT="${ADL_CSM_RUNTIME_PORT:-20997}"
RUNTIME_BASE="${ADL_CSM_RUNTIME_BASE:-https://localhost:$RUNTIME_PORT}"
RUNTIME_ADDRESS="${ADL_CSM_RUNTIME_ADDRESS:-127.0.0.1:$RUNTIME_PORT}"
RUNTIME_PUBLIC_BASE_URL="${ADL_CSM_RUNTIME_PUBLIC_BASE_URL:-$RUNTIME_BASE}"
RUNTIME_SERVER_NAME="${ADL_CSM_RUNTIME_SERVER_NAME:-localhost}"
ALLOW_LOCALHOST_8000_ORIGIN="${ADL_CSM_ALLOW_LOCALHOST_8000_ORIGIN:-0}"
LAUNCH_WORKING_DIR="${ADL_CSM_LAUNCH_WORKING_DIR:-$PRIMARY_REPO_ROOT}"
INIT_FILE="${ADL_CSM_RUNTIME_INIT:-$GENERATED_DIR/runtime-init.current.toml}"
PID_FILE="${ADL_CSM_PID_FILE:-$STATE_DIR/start_CSM.pid}"
SUPERVISOR_PID_FILE="${ADL_CSM_SUPERVISOR_PID_FILE:-$STATE_DIR/start_CSM.supervisor.pid}"
LEASE_PID_FILE="${ADL_CSM_LEASE_PID_FILE:-$STATE_DIR/start_CSM.lease.pid}"
LEASE_INFO_FILE="${ADL_CSM_LEASE_INFO_FILE:-$STATE_DIR/start_CSM.lease.env}"
LEASE_SERVER_FILE="${ADL_CSM_LEASE_SERVER_FILE:-$GENERATED_DIR/start_CSM_lease_server.py}"
RUNNER_FILE="${ADL_CSM_RUNNER_FILE:-$GENERATED_DIR/start_CSM_launch_runner.sh}"
PLIST_FILE="${ADL_CSM_PLIST_FILE:-$GENERATED_DIR/com.agentlogic.start-csm.plist}"
LAUNCH_LABEL="${ADL_CSM_LAUNCH_LABEL:-com.agentlogic.start-csm}"
LAUNCH_DOMAIN="${ADL_CSM_LAUNCH_DOMAIN:-gui/$(id -u)}"
LOG_FILE="${ADL_CSM_LOG_FILE:-$STATE_DIR/start_CSM.log}"
PROBE_FILE="${ADL_CSM_PROBE_FILE:-$STATE_DIR/start_CSM.probe}"
READY_PROBE_FILE="${ADL_CSM_READY_PROBE_FILE:-$STATE_DIR/start_CSM.ready.json}"
PYTHON_BIN="${ADL_CSM_PYTHON_BIN:-/usr/bin/python3}"
CARGO_BIN="${ADL_CSM_CARGO_BIN:-cargo}"
KERNEL_BIN="${ADL_CSM_KERNEL_BIN:-$GENERATED_BIN_DIR/adl-runtime-kernel}"
VECTOR_BIN="${ADL_CSM_VECTOR_BIN:-$BIN_ROOT/.adl/bin/vector}"
OBSERVATORY_SERVER_MANIFEST="${ADL_CSM_OBSERVATORY_SERVER_MANIFEST:-$REPO_ROOT/adl-runtime/Cargo.toml}"
OBSERVATORY_SERVER_BIN="${ADL_CSM_OBSERVATORY_SERVER_BIN:-$REPO_ROOT/adl-runtime/target/debug/adl-observatory-static}"
TLS_FIXTURE_ROOT="${ADL_CSM_TLS_FIXTURE_ROOT:-$REPO_ROOT/adl-runtime/tests/support/tls-fixtures}"
CERT_FILE="${ADL_CSM_TLS_CERT:-$TLS_FIXTURE_ROOT/server-cert.pem}"
KEY_FILE="${ADL_CSM_TLS_KEY:-$TLS_FIXTURE_ROOT/server-key.pem}"
TRUST_ROOTS_FILE="${ADL_CSM_TLS_TRUST_ROOTS:-$TLS_FIXTURE_ROOT/root-ca.pem}"
INTERMEDIATE_CERT_FILE="${ADL_CSM_TLS_INTERMEDIATE:-$TLS_FIXTURE_ROOT/intermediate-ca.pem}"
GUARDIAN_CERT_FILE="${ADL_CSM_GUARDIAN_TLS_CERT:-$TLS_FIXTURE_ROOT/client-cert.pem}"
GUARDIAN_KEY_FILE="${ADL_CSM_GUARDIAN_TLS_KEY:-$TLS_FIXTURE_ROOT/client-key.pem}"
OBSERVATORY_CONFIG_FILE="${ADL_CSM_OBSERVATORY_CONFIG_FILE:-$SERVICE_DIR/CSMctl.observatory.conf}"
if [[ -f "$OBSERVATORY_CONFIG_FILE" ]]; then
  # shellcheck source=/dev/null
  . "$OBSERVATORY_CONFIG_FILE"
fi
# The Observatory config may point the browser at a Runtime hosted on another
# machine (for example AWS). Keep this separate from RUNTIME_BASE so Runtime
# start/status/stop continue to control only the local configured Runtime.
OBSERVATORY_RUNTIME_BASE="${ADL_CSM_OBSERVATORY_RUNTIME_BASE:-${ADL_CSM_RUNTIME_BASE:-$RUNTIME_BASE}}"
OBSERVATORY_REPO_ROOT="${ADL_CSM_OBSERVATORY_REPO_ROOT:-$PRIMARY_REPO_ROOT}"
OBSERVATORY_ENTRY="${ADL_CSM_OBSERVATORY_ENTRY:-$OBSERVATORY_REPO_ROOT/demos/html-observatory/index.html}"
OBSERVATORY_DIR="${ADL_CSM_OBSERVATORY_DIR:-$(dirname "$OBSERVATORY_ENTRY")}"
OBSERVATORY_LAUNCH_WORKING_DIR="${ADL_CSM_OBSERVATORY_LAUNCH_WORKING_DIR:-$OBSERVATORY_DIR}"
OBSERVATORY_HOST="${ADL_CSM_OBSERVATORY_HOST:-127.0.0.1}"
OBSERVATORY_PORT="${ADL_CSM_OBSERVATORY_PORT:-8765}"
OBSERVATORY_PORTS="${ADL_CSM_OBSERVATORY_PORTS:-$OBSERVATORY_PORT}"
OBSERVATORY_BASE="${ADL_CSM_OBSERVATORY_BASE:-https://localhost:$OBSERVATORY_PORT}"
OBSERVATORY_URL="${ADL_CSM_OBSERVATORY_URL:-$OBSERVATORY_BASE/index.html?runtime=v3&runtimeApiBase=$OBSERVATORY_RUNTIME_BASE&live=1}"
OBSERVATORY_PUBLIC_ORIGIN="${ADL_CSM_OBSERVATORY_PUBLIC_ORIGIN:-}"
OBSERVATORY_TLS_CERT="${ADL_CSM_OBSERVATORY_TLS_CERT:-${ADL_CSM_API_TLS_CERT:-$CERT_FILE}}"
OBSERVATORY_TLS_KEY="${ADL_CSM_OBSERVATORY_TLS_KEY:-${ADL_CSM_API_TLS_KEY:-$KEY_FILE}}"
OBSERVATORY_PID_FILE="${ADL_CSM_OBSERVATORY_PID_FILE:-$STATE_DIR/CSMctl.observatory.pid}"
OBSERVATORY_STATE_FILE="${ADL_CSM_OBSERVATORY_STATE_FILE:-$STATE_DIR/CSMctl.observatory.env}"
OBSERVATORY_LOG_FILE="${ADL_CSM_OBSERVATORY_LOG_FILE:-$STATE_DIR/CSMctl.observatory.log}"

detect_host_os() {
  if [[ "${ADL_CSM_TEST_MODE:-0}" == "1" && -n "${ADL_CSM_TEST_OS:-}" ]]; then
    printf '%s' "$ADL_CSM_TEST_OS"
  else
    uname -s
  fi
}

HOST_OS="$(detect_host_os)"
case "$HOST_OS" in
  Darwin) SERVICE_BACKEND="launchd" ;;
  Linux) SERVICE_BACKEND="linux-process" ;;
  *)
    printf 'CSMctl status=failed reason=unsupported_operating_system:%s\n' "$HOST_OS" >&2
    exit 1
    ;;
esac

usage() {
  printf '%s\n' \
    'Usage: ./CSMctl observatory [start|status|stop|open|urls|logs]' \
    '' \
    'Commands:' \
    '  observatory' \
    '          Control only the static HTML Observatory service. This does not start' \
    '          or stop Runtime and may point at any configured Runtime API base.' \
    '' \
    'Permanent Runtime control:' \
    "  \"$CSM_RUNTIME_BIN\" runtime-v3 <start|stop|status|reload> \\" \
    "    --init \"$CSM_RUNTIME_INIT\" --json"
}

info() {
  printf 'CSMctl %s\n' "$*"
}

fail() {
  printf 'CSMctl status=failed reason=%s\n' "$*" >&2
  exit 1
}

require_file() {
  [[ -f "$1" ]] || fail "missing_$2: $1"
}

require_executable() {
  [[ -x "$1" ]] || fail "missing_or_not_executable_$2: $1"
}

LAST_READY_CODE="000"
LAST_OBSERVATORY_CODE="000"
LAST_HEALTH_CODE="000"

spki_sha256() {
  openssl x509 -in "$1" -pubkey -noout \
    | openssl pkey -pubin -outform DER 2>/dev/null \
    | openssl dgst -sha256 -binary \
    | xxd -p -c 256
}

ed25519_public_hex_from_private() {
  openssl pkey -in "$1" -pubout -outform DER 2>/dev/null | tail -c 32 | xxd -p -c 256
}

load_service_env() {
  require_file "$ENV_FILE" "service_env"
  local shell_options="$-"
  set +u
  set -a
  # shellcheck source=/dev/null
  . "$ENV_FILE"
  set +a
  if [[ "$shell_options" == *u* ]]; then
    set -u
  fi
}

require_env() {
  local name="$1"
  [[ -n "${!name:-}" ]] || fail "missing_required_service_env_$name"
}

write_secret_file() {
  umask 077
  printf '%s\n' "$2" > "$1"
}

write_lease_server() {
  mkdir -p "$GENERATED_DIR"
  cat > "$LEASE_SERVER_FILE" <<'PY'
import pathlib
import os
import signal
import socket
import sys
import time

info_path = pathlib.Path(sys.argv[1])
token = sys.argv[2].encode()

signal.signal(signal.SIGHUP, signal.SIG_IGN)

sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
sock.bind(("127.0.0.1", 0))
sock.listen(1)
host, port = sock.getsockname()
info_path.write_text(f"address={host}:{port}\n", encoding="utf-8")

conn, _peer = sock.accept()
supplied = conn.recv(len(token))
if supplied != token:
    conn.close()
    raise SystemExit(2)
conn.sendall(b"ok" + os.getpid().to_bytes(4, byteorder="big", signed=False))

while True:
    data = conn.recv(1)
    if not data:
        break
PY
  chmod 700 "$LEASE_SERVER_FILE"
}

xml_escape() {
  printf '%s' "$1" \
    | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

write_launch_runner() {
  mkdir -p "$GENERATED_DIR"
  cat > "$RUNNER_FILE" <<EOF
#!/usr/bin/env bash
set -Eeuo pipefail
mkdir -p "$STATE_DIR"
kernel_pid=""
lease_pid=""
graceful_shutdown() {
  trap - TERM INT
  if [[ -n "\$kernel_pid" ]] && kill -0 "\$kernel_pid" 2>/dev/null; then
    printf 'CSMctl event=graceful_shutdown pid=%s\n' "\$kernel_pid" >> "$LOG_FILE"
    kill -TERM "\$kernel_pid" 2>/dev/null || true
    wait "\$kernel_pid" || true
  fi
  if [[ -n "\$lease_pid" ]] && kill -0 "\$lease_pid" 2>/dev/null; then
    kill -TERM "\$lease_pid" 2>/dev/null || true
    wait "\$lease_pid" || true
  fi
  rm -f "$PID_FILE" "$LEASE_PID_FILE" "$LEASE_INFO_FILE"
  exit 0
}
trap graceful_shutdown TERM INT
lease_token="\$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')"
: > "$LEASE_INFO_FILE"
"$PYTHON_BIN" "$LEASE_SERVER_FILE" "$LEASE_INFO_FILE" "\$lease_token" >> "$LOG_FILE" 2>&1 &
lease_pid="\$!"
printf '%s\n' "\$lease_pid" > "$LEASE_PID_FILE"
for _ in \$(seq 1 40); do
  [[ -s "$LEASE_INFO_FILE" ]] && break
  sleep 0.05
done
lease_address="\$(sed -n 's/^address=//p' "$LEASE_INFO_FILE" | head -1)"
[[ -n "\$lease_address" ]] || exit 70
cd "$LAUNCH_WORKING_DIR"
ADL_RUNTIME_GUARDIAN_LEASE_ADDRESS="\$lease_address" \\
  ADL_RUNTIME_GUARDIAN_LEASE_TOKEN="\$lease_token" \\
  "$KERNEL_BIN" serve --init "$INIT_FILE" >> "$LOG_FILE" 2>&1 &
kernel_pid="\$!"
printf '%s\n' "\$kernel_pid" > "$PID_FILE"
wait "\$kernel_pid"
rm -f "$PID_FILE" "$LEASE_PID_FILE" "$LEASE_INFO_FILE"
EOF
  chmod 700 "$RUNNER_FILE"
}

