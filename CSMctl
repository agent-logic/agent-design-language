    command -v "$CARGO_BIN" >/dev/null 2>&1 || fail "missing_observatory_server_bin_and_cargo: $OBSERVATORY_SERVER_BIN"
    "$CARGO_BIN" build --quiet --manifest-path "$OBSERVATORY_SERVER_MANIFEST" --bin adl-observatory-static
  fi
  require_file "$OBSERVATORY_TLS_CERT" "observatory_tls_certificate"
  require_file "$OBSERVATORY_TLS_KEY" "observatory_tls_private_key"
  require_file "$OBSERVATORY_SERVER_BIN" "observatory_server_binary"
  [[ -d "$OBSERVATORY_DIR" ]] || fail "missing_observatory_dir: $OBSERVATORY_DIR"
  [[ -d "$OBSERVATORY_LAUNCH_WORKING_DIR" ]] || fail "missing_observatory_launch_working_dir: $OBSERVATORY_LAUNCH_WORKING_DIR"
  [[ "$OBSERVATORY_PORT" == "8765" ]] || fail "observatory_fixed_port_violation configured_port=$OBSERVATORY_PORT expected=8765"
  [[ "$OBSERVATORY_PORTS" == "8765" ]] || fail "observatory_fixed_port_violation configured_ports='$OBSERVATORY_PORTS' expected=8765"
  mkdir -p "$STATE_DIR" "$GENERATED_DIR"
}

pid_is_alive() {
  local pid="$1"
  [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null || return 1
  if [[ "$HOST_OS" == "Linux" && -r "/proc/$pid/stat" ]]; then
    local stat rest state
    stat="$(<"/proc/$pid/stat")"
    rest="${stat##*) }"
    state="${rest%% *}"
    [[ "$state" != "Z" ]] || return 1
  fi
}

linux_pid_matches() {
  local pid="$1"
  local expected="$2"
  local expected_start_time="${3:-}"
  [[ "$HOST_OS" == "Linux" && "$pid" =~ ^[0-9]+$ ]] || return 1
  python3 - "$pid" "$expected" "$expected_start_time" <<'PY'
import os
import sys

pid, expected, expected_start = sys.argv[1:]
try:
    stat = open(f"/proc/{pid}/stat", encoding="utf-8").read()
    start_time = stat[stat.rfind(")") + 2 :].split()[19]
    argv = open(f"/proc/{pid}/cmdline", "rb").read().rstrip(b"\0").split(b"\0")
    exe = os.path.realpath(f"/proc/{pid}/exe")
except (FileNotFoundError, IndexError, OSError):
    raise SystemExit(1)
if expected_start and start_time != expected_start:
    raise SystemExit(1)
valid_argv = len(argv) >= 2 and os.path.basename(exe) in {"bash", "sh"} and os.fsdecode(argv[1]) == expected
if not valid_argv:
    raise SystemExit(1)
print(start_time, end="")
PY
}

linux_signal_owned() {
  local pid="$1"
  local expected="$2"
  local expected_start_time="$3"
  python3 - "$pid" "$expected" "$expected_start_time" <<'PY'
import os
import signal
import sys

pid_text, expected, expected_start = sys.argv[1:]
pid = int(pid_text)
pidfd = os.pidfd_open(pid)
try:
    stat = open(f"/proc/{pid}/stat", encoding="utf-8").read()
    start_time = stat[stat.rfind(")") + 2 :].split()[19]
    argv = open(f"/proc/{pid}/cmdline", "rb").read().rstrip(b"\0").split(b"\0")
    exe = os.path.realpath(f"/proc/{pid}/exe")
    if start_time != expected_start:
        raise SystemExit(1)
    valid_argv = len(argv) >= 2 and os.path.basename(exe) in {"bash", "sh"} and os.fsdecode(argv[1]) == expected
    if not valid_argv:
        raise SystemExit(1)
    signal.pidfd_send_signal(pidfd, signal.SIGTERM)
finally:
    os.close(pidfd)
PY
}

recorded_pid() {
  [[ -f "$PID_FILE" ]] || return 1
  local pid
  pid="$(tr -d '[:space:]' < "$PID_FILE")"
  [[ -n "$pid" ]] || return 1
  printf '%s' "$pid"
}

observatory_pid() {
  [[ -f "$OBSERVATORY_PID_FILE" ]] || return 1
  local pid
  pid="$(tr -d '[:space:]' < "$OBSERVATORY_PID_FILE")"
  [[ -n "$pid" ]] || return 1
  printf '%s' "$pid"
}

curl_probe() {
  mkdir -p "$STATE_DIR"
  local url="$1"
  local output="$2"
  local code
  local curl_tls_args=()
  if [[ "${ADL_CSM_PROBE_INSECURE_TLS:-0}" == "1" ]]; then
    curl_tls_args=(-k)
  elif [[ -f "$STATE_TLS_DIR/api-trust-roots.pem" ]]; then
    curl_tls_args=(--cacert "$STATE_TLS_DIR/api-trust-roots.pem")
  else
    curl_tls_args=(-k)
  fi
  code="$(curl "${curl_tls_args[@]}" -sS --max-time 3 -o "$output" -w '%{http_code}' "$url" 2>/dev/null)" || code="000"
  printf '%s' "$code"
}

curl_code() {
  curl_probe "$1" "$PROBE_FILE"
}

observatory_probe() {
  local base="${1:-$OBSERVATORY_BASE}"
  local code
  code="$(curl -k -sS --max-time 3 -o "$PROBE_FILE" -w '%{http_code}' "$base/index.html" 2>/dev/null)" || code="000"
  printf '%s' "$code"
}

recompute_observatory_url() {
  OBSERVATORY_URL="${ADL_CSM_OBSERVATORY_URL:-$OBSERVATORY_BASE/index.html?runtime=v3&runtimeApiBase=$OBSERVATORY_RUNTIME_BASE&live=1}"
}

write_observatory_state() {
  mkdir -p "$STATE_DIR"
  {
    printf 'OBSERVATORY_BASE=%q\n' "$OBSERVATORY_BASE"
    printf 'OBSERVATORY_RUNTIME_BASE=%q\n' "$OBSERVATORY_RUNTIME_BASE"
    printf 'OBSERVATORY_URL=%q\n' "$OBSERVATORY_URL"
  } > "$OBSERVATORY_STATE_FILE"
  chmod 600 "$OBSERVATORY_STATE_FILE"
}

load_observatory_state() {
  [[ -f "$OBSERVATORY_STATE_FILE" ]] || return 1
  # shellcheck source=/dev/null
  . "$OBSERVATORY_STATE_FILE"
  recompute_observatory_url
}

probe_runtime() {
  LAST_READY_CODE="$(curl_probe "$RUNTIME_BASE/v1/ready" "$READY_PROBE_FILE")"
  LAST_OBSERVATORY_CODE="$(curl_code "$RUNTIME_BASE/v1/observatory")"
  LAST_HEALTH_CODE="$(curl_code "$RUNTIME_BASE/v1/health")"
  info "probe /v1/ready http=$LAST_READY_CODE"
  info "probe /v1/observatory http=$LAST_OBSERVATORY_CODE"
  info "probe /v1/health http=$LAST_HEALTH_CODE"
  [[ "$LAST_READY_CODE" == "200" && "$LAST_OBSERVATORY_CODE" == "200" && "$LAST_HEALTH_CODE" == "200" ]]
}

runtime_is_responding() {
  [[ "$LAST_READY_CODE" != "000" || "$LAST_OBSERVATORY_CODE" != "000" || "$LAST_HEALTH_CODE" != "000" ]]
}

launch_service_loaded() {
  case "$SERVICE_BACKEND" in
    launchd)
      launchctl print "$LAUNCH_DOMAIN/$LAUNCH_LABEL" >/dev/null 2>&1
      ;;
    linux-process)
      local pid start_time
      [[ -f "$SUPERVISOR_PID_FILE" ]] || return 1
      read -r pid start_time < "$SUPERVISOR_PID_FILE" || true
      [[ "$pid" =~ ^[0-9]+$ && "$start_time" =~ ^[0-9]+$ ]] \
        || fail "invalid_linux_supervisor_pid_file:$SUPERVISOR_PID_FILE"
      if ! pid_is_alive "$pid"; then
        rm -f "$SUPERVISOR_PID_FILE"
        return 1
      fi
      linux_pid_matches "$pid" "$RUNNER_FILE" "$start_time" >/dev/null \
        || fail "linux_supervisor_pid_not_owned pid=$pid"
      ;;
  esac
}

launch_service_pid() {
  case "$SERVICE_BACKEND" in
    launchd)
      launchctl print "$LAUNCH_DOMAIN/$LAUNCH_LABEL" 2>/dev/null \
        | sed -n 's/^[[:space:]]*pid = //p' \
        | head -1
      ;;
    linux-process)
      launch_service_loaded || return 1
      awk '{print $1}' "$SUPERVISOR_PID_FILE"
      ;;
  esac
}

launch_service_start() {
  if launch_service_loaded; then
    launch_service_stop
    for _ in $(seq 1 80); do
      launch_service_loaded || break
      sleep 0.25
    done
    launch_service_loaded \
      && fail "owned_service_did_not_stop_before_start"
  fi
  case "$SERVICE_BACKEND" in
    launchd)
      launchctl bootstrap "$LAUNCH_DOMAIN" "$PLIST_FILE"
      ;;
    linux-process)
      mkdir -p "$STATE_DIR"
      nohup "$RUNNER_FILE" >> "$LOG_FILE" 2>&1 < /dev/null &
      local supervisor_pid=$!
      sleep 0.05
      local supervisor_start_time
      supervisor_start_time="$(linux_pid_matches "$supervisor_pid" "$RUNNER_FILE")" \
        || fail "linux_supervisor_identity_unavailable pid=$supervisor_pid"
      printf '%s %s\n' "$supervisor_pid" "$supervisor_start_time" > "$SUPERVISOR_PID_FILE"
      launch_service_loaded \
        || fail "linux_supervisor_failed_to_start log=$LOG_FILE"
      ;;
  esac
}

launch_service_stop() {
  launch_service_loaded || return 1
  case "$SERVICE_BACKEND" in
    launchd)
      launchctl bootout "$LAUNCH_DOMAIN/$LAUNCH_LABEL"
      ;;
    linux-process)
      local pid start_time
      read -r pid start_time < "$SUPERVISOR_PID_FILE" || true
      linux_pid_matches "$pid" "$RUNNER_FILE" "$start_time" >/dev/null \
        || fail "linux_supervisor_pid_not_owned pid=$pid"
      linux_signal_owned "$pid" "$RUNNER_FILE" "$start_time" \
        || fail "linux_supervisor_pid_not_owned pid=$pid"
      local stop_attempts=80
      for _ in $(seq 1 "$stop_attempts"); do
        pid_is_alive "$pid" || break
        sleep 0.25
      done
      if pid_is_alive "$pid"; then
        fail "linux_supervisor_did_not_stop pid=$pid"
      fi
      rm -f "$SUPERVISOR_PID_FILE"
      ;;
  esac
}

start_observatory_process() {
  local port="$1"
  (
    cd "$OBSERVATORY_LAUNCH_WORKING_DIR"
    "$OBSERVATORY_SERVER_BIN" \
      --daemon \
      --pid-file "$OBSERVATORY_PID_FILE" \
      --log-file "$OBSERVATORY_LOG_FILE" \
      --host "$OBSERVATORY_HOST" \
      --port "$port" \
      --cert "$OBSERVATORY_TLS_CERT" \
      --key "$OBSERVATORY_TLS_KEY" \
      --root "$OBSERVATORY_DIR"
  )
}

start_observatory_server() {
  ensure_observatory_config
  local pid code port base url
  load_observatory_state || true
  if pid="$(observatory_pid 2>/dev/null)" && pid_is_alive "$pid"; then
    code="$(observatory_probe "$OBSERVATORY_BASE")"
    if [[ "$code" == "200" ]]; then
      info "observatory_server=running url=$OBSERVATORY_URL"
      return 0
    fi
    kill -TERM "$pid" 2>/dev/null || true
    for _ in $(seq 1 40); do
      pid_is_alive "$pid" || break
      sleep 0.25
    done
    rm -f "$OBSERVATORY_PID_FILE"
  fi
  if [[ -n "${ADL_CSM_OBSERVATORY_URL:-}" ]]; then
    code="$(observatory_probe "$OBSERVATORY_BASE")"
    if [[ "$code" == "200" ]]; then
      info "observatory_server=running url=$OBSERVATORY_URL"
      return 0
    fi
  fi

  for port in $OBSERVATORY_PORTS; do
    base="https://localhost:$port"
    url="$base/index.html?runtime=v3&runtimeApiBase=$OBSERVATORY_RUNTIME_BASE&live=1"
    OBSERVATORY_BASE="$base"
    OBSERVATORY_URL="$url"

    rm -f "$OBSERVATORY_PID_FILE" "$OBSERVATORY_STATE_FILE"
    : > "$OBSERVATORY_LOG_FILE"
    start_observatory_process "$port"
    for _ in $(seq 1 40); do
      code="$(observatory_probe "$base")"
      if [[ "$code" == "200" ]] && pid="$(observatory_pid 2>/dev/null)" && pid_is_alive "$pid"; then
        write_observatory_state
        info "observatory_server=running url=$url"
        return 0
      fi
      sleep 0.25
    done
    if grep -q 'Address already in use' "$OBSERVATORY_LOG_FILE" 2>/dev/null; then
      info "observatory_port_unavailable port=$port action=try_next"
      if pid="$(observatory_pid 2>/dev/null)" && pid_is_alive "$pid"; then
        kill -TERM "$pid" 2>/dev/null || true
      fi
      rm -f "$OBSERVATORY_PID_FILE" "$OBSERVATORY_STATE_FILE"
      continue
    fi
    if pid="$(observatory_pid 2>/dev/null)" && pid_is_alive "$pid"; then
      kill -TERM "$pid" 2>/dev/null || true
    fi
  done
  fail "observatory_server_not_ready ports='$OBSERVATORY_PORTS' log=$OBSERVATORY_LOG_FILE"
}

stop_observatory_server() {
  local pid
  if pid="$(observatory_pid 2>/dev/null)" && pid_is_alive "$pid"; then
    kill -TERM "$pid" 2>/dev/null || true
    for _ in $(seq 1 40); do
      pid_is_alive "$pid" || break
      sleep 0.25
    done
  fi
  rm -f "$OBSERVATORY_PID_FILE" "$OBSERVATORY_STATE_FILE"
}

checkpoint_signature_failed() {
  [[ -f "$LOG_FILE" ]] && tail -80 "$LOG_FILE" | grep -q 'checkpoint signature verification failed'
}

quarantine_dir_if_present() {
  local source_dir="$1"
  local label="$2"
  local reason="$3"
  [[ -d "$source_dir" ]] || return 0
  mkdir -p "$QUARANTINE_DIR"
  local stamp target
  stamp="$(date -u '+%Y%m%dT%H%M%SZ')"
  target="$QUARANTINE_DIR/$label-$reason-$stamp"
  if [[ -e "$target" ]]; then
    target="$target-$$"
  fi
  mv "$source_dir" "$target"
  info "event=quarantined_state label=$label reason=$reason path=$target"
}

quarantine_continuity_state() {
  local reason="$1"
  quarantine_dir_if_present "$CONTINUITY_ROOT" "private-continuity" "$reason"
  quarantine_dir_if_present "$CONTINUITY_HISTORY_ROOT" "continuity-history" "$reason"
  mkdir -p "$CONTINUITY_ROOT/guardian" "$CONTINUITY_ROOT/kernel" "$CONTINUITY_ROOT/staging"
}

urls_cmd() {
  load_observatory_state || true
  info "backend=$SERVICE_BACKEND host_os=$HOST_OS"
  info "runtime=$RUNTIME_BASE"
  info "observatory=$OBSERVATORY_URL"
  info "observatory_runtime_api_base=$OBSERVATORY_RUNTIME_BASE"
  info "observatory_file=$OBSERVATORY_ENTRY?runtime=v3&runtimeApiBase=$OBSERVATORY_RUNTIME_BASE&live=1"
}

status_cmd() {
  info "repo_root=$REPO_ROOT"
  info "service_dir=$SERVICE_DIR"
  info "kernel_bin=$KERNEL_BIN"
  info "init_file=$INIT_FILE"
  local launch_pid="" pid
  if launch_service_loaded; then
    launch_pid="$(launch_service_pid)"
  fi
  if [[ -n "$launch_pid" ]]; then
    info "launch_label=$LAUNCH_LABEL pid=$launch_pid state=running"
  elif pid="$(recorded_pid 2>/dev/null)" && pid_is_alive "$pid"; then
    info "pid=$pid state=alive"
  else
    info "pid=none state=not_started_by_start_CSM"
  fi
  if probe_runtime; then
    info "status=pass runtime_base=$RUNTIME_BASE"
  else
    fail "runtime_not_ready_or_not_serving"
  fi
}

up_cmd() {
  ensure_current_init
  if probe_runtime; then
    info "status=pass runtime_base=$RUNTIME_BASE"
    urls_cmd
    return 0
  fi
  if runtime_is_responding; then
    fail "runtime_present_but_not_all_200 ready=$LAST_READY_CODE observatory=$LAST_OBSERVATORY_CODE health=$LAST_HEALTH_CODE refusing_to_kill_or_replace_existing_runtime"
  fi

  : > "$LOG_FILE"
  info "starting launch_label=$LAUNCH_LABEL"
  launch_service_start

  for _ in $(seq 1 80); do
    if probe_runtime; then
      info "status=pass runtime_base=$RUNTIME_BASE"
      urls_cmd
      return 0
    fi
    sleep 0.25
  done
  if [[ "${ADL_CSM_RECOVER_INVALID_CONTINUITY:-1}" == "1" ]] && checkpoint_signature_failed; then
    info "event=checkpoint_signature_verification_failed action=quarantine_and_retry_once"
    launch_service_stop >/dev/null 2>&1
    quarantine_continuity_state "signature-failed"
    ensure_current_init
    : > "$LOG_FILE"
    info "starting launch_label=$LAUNCH_LABEL retry=after_continuity_quarantine"
    launch_service_start
    for _ in $(seq 1 80); do
      if probe_runtime; then
        info "status=pass runtime_base=$RUNTIME_BASE"
        urls_cmd
        return 0
      fi
      sleep 0.25
    done
  fi
  fail "runtime_started_but_not_ready log=$LOG_FILE"
}

rotate_continuity_state_cmd() {
  stop_cmd
  quarantine_continuity_state "operator-rotation"
  ensure_current_init
  info "status=pass action=continuity_state_rotated next=start"
}

open_cmd() {
  [[ "$SERVICE_BACKEND" == "launchd" ]] \
    || fail "observatory_control_not_supported_on_$HOST_OS"
  up_cmd
  start_observatory_server
  info "opening=$OBSERVATORY_URL"
  open "$OBSERVATORY_URL"
}

stop_cmd() {
  if ! launch_service_loaded; then
    info "status=not_running launch_label=$LAUNCH_LABEL"
    return 0
  fi
  info "stopping launch_label=$LAUNCH_LABEL mode=graceful"
  launch_service_stop
  for _ in $(seq 1 80); do
    if ! launch_service_loaded && ! probe_runtime; then
      if ! runtime_is_responding; then
        rm -f "$PID_FILE" "$LEASE_PID_FILE" "$LEASE_INFO_FILE"
        info "status=stopped"
        return 0
      fi
    fi
    sleep 0.25
  done
  fail "runtime_stop_not_confirmed ready=$LAST_READY_CODE observatory=$LAST_OBSERVATORY_CODE health=$LAST_HEALTH_CODE log=$LOG_FILE"
}

restart_cmd() {
  launch_service_loaded || fail "restart_requires_owned_runtime_service"
  stop_cmd
  up_cmd
}

logs_cmd() {
  if [[ -f "$LOG_FILE" ]]; then
    tail -80 "$LOG_FILE"
  else
    info "log_absent=$LOG_FILE"
  fi
}

observatory_status_cmd() {
  local pid code
  if pid="$(observatory_pid 2>/dev/null)" && pid_is_alive "$pid"; then
    load_observatory_state || true
    code="$(observatory_probe)"
    info "observatory_pid=$pid state=running http=$code url=$OBSERVATORY_URL"
    [[ "$code" == "200" ]] || fail "observatory_not_serving_200"
  else
    info "observatory_pid=none state=not_running"
    return 1
  fi
}

observatory_urls_cmd() {
  load_observatory_state || true
  info "observatory=$OBSERVATORY_URL"
  info "runtime_api_base=$OBSERVATORY_RUNTIME_BASE"
  info "observatory_dir=$OBSERVATORY_DIR"
}

observatory_logs_cmd() {
  if [[ -f "$OBSERVATORY_LOG_FILE" ]]; then
    tail -80 "$OBSERVATORY_LOG_FILE"
  else
    info "observatory_log_absent=$OBSERVATORY_LOG_FILE"
  fi
}

observatory_open_cmd() {
  start_observatory_server
  info "opening=$OBSERVATORY_URL"
  open "$OBSERVATORY_URL"
}

observatory_cmd() {
  [[ "$SERVICE_BACKEND" == "launchd" ]] \
    || fail "observatory_control_not_supported_on_$HOST_OS"
  case "${1:-start}" in
    start) start_observatory_server ;;
    status) observatory_status_cmd ;;
    stop) stop_observatory_server; info "observatory_status=stopped" ;;
    open) observatory_open_cmd ;;
    urls) observatory_urls_cmd ;;
    logs) observatory_logs_cmd ;;
    *) usage >&2; fail "unknown_observatory_command=$1" ;;
  esac
}

case "${1:-help}" in
  observatory) shift; observatory_cmd "$@" ;;
  -h|--help|help) usage ;;
  *) usage >&2; fail "unknown_command=$1" ;;
esac
