[Unit]
Description=CodeFriend idle-stop check
After=codefriend-website.service codefriend-gateway.service

[Service]
Type=oneshot
User=root
UMask=0077
RuntimeDirectory=codefriend-idle-stop
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/codefriend/current/host/idle_stop.py --execute
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/codefriend-idle-stop
