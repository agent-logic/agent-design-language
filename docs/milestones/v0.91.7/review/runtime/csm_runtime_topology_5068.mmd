flowchart TD
  tokio["Tokio core event loop"]
  main["CSM executive"]
  supervisor["futures::JoinSet<br/>supervised component groups"]
  bus["typed runtime channels<br/>backpressure + health + lifecycle"]

  tokio --> main --> supervisor --> bus

  subgraph groups["Component futures"]
    direction LR
    communications["Communications<br/>runtime_api<br/>acip_carrier<br/>cloud_bridge"]
    temporal["Time + scheduling<br/>chronosense<br/>scheduler"]
    cognition["Cognition + governance<br/>reasoning_runtime<br/>curiosity_engine<br/>constructability_gate<br/>freedom_gate<br/>AEE"]
    security["Security<br/>CAV<br/>authn/authz<br/>policy gates"]
    operations["Operations<br/>polis_shepherd_agent<br/>checkpoint<br/>lifelog<br/>safe-fail serialization"]
    observability["Observability<br/>CSM-managed Vector<br/>OTel + metrics + logs"]
  end

  bus --> communications
  bus --> temporal
  bus --> cognition
  bus --> security
  bus --> operations
  bus --> observability

  subgraph sinks["Retained evidence and external routes"]
    direction LR
    cloudwatch["CloudWatch<br/>logs + metrics"]
    otel["OTel<br/>traces + metrics"]
    storage["S3 / DB<br/>retention"]
    notices["SNS / SQS<br/>notices"]
  end

  observability --> cloudwatch
  observability --> otel
  operations --> storage
  communications --> notices

  classDef core fill:#05264a,stroke:#05264a,color:#ffffff,rx:4,ry:4;
  classDef task fill:#f6d7f7,stroke:#e34cf2,color:#061f3d,rx:4,ry:4;
  classDef set fill:#d8e8ff,stroke:#2f7df6,color:#061f3d,rx:4,ry:4;
  classDef bus fill:#eef3f8,stroke:#b9c7d3,color:#061f3d,rx:4,ry:4;
  classDef component fill:#d7f7fb,stroke:#18bfd6,color:#061f3d,rx:4,ry:4;
  classDef sink fill:#f3f6e8,stroke:#9aae39,color:#26310c,rx:4,ry:4;

  class tokio core;
  class main task;
  class supervisor set;
  class bus bus;
  class communications,temporal,cognition,security,operations,observability component;
  class cloudwatch,otel,storage,notices sink;
