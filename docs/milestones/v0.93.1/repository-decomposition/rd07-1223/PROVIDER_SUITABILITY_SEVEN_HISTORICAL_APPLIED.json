  "historical_disposition": {
    "v0915_quality": "Fixed2026-06-15 issue3725 HTTP experiment writes dated historical packet. Do not rerun or replace historical proof.",
    "v0915_openrouter_remote_gemma": "Historical experiment production builds retired monolith adl-provider-adapter/adl interfaces; remoteGemma fixed private Ollama address and dated2026-06-15 output.",
    "v0916_generic_deepseek": "Coupled generic alias and producer build retired monolith ADL/provider binaries; caller-independent validators and historical packet tests remain.",
    "two_specs": "Two OpenRouter experiment configurations have no remaining active consumer after producer retirement. DeepSeek panel4096 spec remains for explicit historical packet validation.",
    "decision": "Retire historical ADL experiment-production interfaces, preserve original assertions and owner source. Not proof of replacement execution or retirement of Runtime model/provider capability."
  },
  "caller_closure": "Current tools/config/workflows contain no incoming producer invocation except generic alias removed together and registry repaired. Current retained tests validate recorded packets only; all their bytes preserved. Historical milestone reproduction commands remain original-revision obligations, not current ADL routes.",
