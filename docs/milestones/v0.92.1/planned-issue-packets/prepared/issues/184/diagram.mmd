flowchart TB
  ID["agent-logic-admin business AWS identity gate"] --> W["Wuji voter"]
  ID --> A["Private AWS voter / AZ-A"]
  ID --> B["Private AWS voter / AZ-B"]
  W & A & B --> TLS["Authenticated private transport"]
  TLS --> Q3["3-voter commit"]
  Q3 --> ISO["Isolate Wuji"]
  ISO --> Q2["AWS-only quorum continues"]
  ISO --> FENCE["Stale Wuji mutation fenced"]
  Q2 --> LOSS["Remove one AWS voter"]
  LOSS --> HALT["No quorum: mutation halts"]
  HALT --> HEAL["Heal topology"]
  HEAL --> CONV["Term, index, state, fence, Observatory converge"]
  A --> SA["Independent snapshot A"]
  B --> SB["Independent snapshot B"]
  CONV & SA & SB --> CLEAN["Provider-enumerated cleanup and cost receipt"]
