{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adl.v092.first-birthday-review-packet.schema.v1",
  "title": "ADL v0.92 first-birthday review evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "digest_algorithm",
    "packet_sha256",
    "closure_evidence",
    "entries",
    "public_claims",
    "non_claims",
    "reviewer_questions"
  ],
  "properties": {
    "schema": { "const": "adl.v092.first-birthday-review-evidence.v1" },
    "digest_algorithm": { "const": "sha256" },
    "packet_sha256": { "$ref": "#/$defs/sha256" },
    "closure_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "$ref": "#/$defs/repoPath" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/entry" }
    },
    "public_claims": { "$ref": "#/$defs/boundedStrings" },
    "non_claims": { "$ref": "#/$defs/boundedStrings" },
    "reviewer_questions": { "$ref": "#/$defs/boundedStrings" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "repoPath": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9._/-]+$" },
    "boundedStrings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wp", "issue_repository", "code_repository", "issue", "pull_request", "revision", "merge_commit", "path", "digest", "terminal_state", "review_state", "reviewed_revision", "public_projection"],
      "properties": {
        "wp": { "type": "string", "pattern": "^WP-[0-9]+A?$" },
        "issue_repository": { "$ref": "#/$defs/repository" },
        "code_repository": { "$ref": "#/$defs/repository" },
        "issue": { "type": "integer", "minimum": 1 },
        "pull_request": { "type": "integer", "minimum": 1 },
        "revision": { "$ref": "#/$defs/gitSha" },
        "merge_commit": { "$ref": "#/$defs/gitSha" },
        "path": { "$ref": "#/$defs/repoPath" },
        "digest": { "$ref": "#/$defs/sha256" },
        "terminal_state": { "const": "merged_closed" },
        "review_state": { "const": "approved" },
        "reviewed_revision": { "type": "string", "pattern": "^(?:git-blake3:[0-9a-f]{40}:[0-9a-f]{64}|[0-9a-f]{40})$" },
        "public_projection": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    }
  }
}
