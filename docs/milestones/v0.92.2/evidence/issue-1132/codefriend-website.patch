From bd5d18ce1d614400d6c00ff93f0f1200818356f1 Mon Sep 17 00:00:00 2001
From: "Daniel B. Austin" <daniel@danielaustin.org>
Date: Mon, 21 Sep 2026 20:23:13 -0700
Subject: [PATCH 2/4] fix: forward original cycle review evidence through model
 proxy

---
 app/agents.mjs             |  2 +-
 app/http.mjs               |  2 +-
 tests/application.test.mjs | 50 ++++++++++++++++++++++++++++++++++++++
 3 files changed, 52 insertions(+), 2 deletions(-)

diff --git a/app/agents.mjs b/app/agents.mjs
index 26bc09a..2c511e5 100644
--- a/app/agents.mjs
+++ b/app/agents.mjs
@@ -114,7 +114,7 @@ export class Agents {
       const reserved = this.store.get('model-operation', id, agent.subject);
       if (!reserved || reserved.agentId !== agent.id || reserved.runId !== owner.run.id) throw new RunError('model_run_denied');
       if (!((method === 'GET' && !path.endsWith('/cancel')) || (method === 'POST' && path.endsWith('/cancel')))) throw new RunError('method_denied');
-      if (path.endsWith('/result') && (owner.run.cancelRequested || !['running','complete'].includes(owner.run.status))) throw new RunError('model_run_denied');
+      if ((path.endsWith('/result') || path.endsWith('/review-evidence')) && (owner.run.cancelRequested || !['running','complete'].includes(owner.run.status))) throw new RunError('model_run_denied');
     }
     return owner;
   }
diff --git a/app/http.mjs b/app/http.mjs
index 2e3e531..c9c03ed 100644
--- a/app/http.mjs
+++ b/app/http.mjs
@@ -67,7 +67,7 @@ export function application({ origin, oauth, sessions, runs, store, agents, repo
       if (method === 'GET' && url.pathname === '/beta' && workspace) {
         response.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' }); response.end(workspace); return;
       }
-      if (credentials && modelGateway && /^\/v1\/operations(?:\/[A-Za-z0-9_-]{1,80}(?:\/(?:cancel|result))?)?$/.test(url.pathname)) {
+      if (credentials && modelGateway && /^\/v1\/operations(?:\/[A-Za-z0-9_-]{1,80}(?:\/(?:cancel|result|review-evidence))?)?$/.test(url.pathname)) {
         const bearer = /^Bearer ([A-Za-z0-9_-]{43})$/.exec(request.headers.authorization || '')?.[1];
         const identity = await credentials.validate(bearer, 'local_model');
         if (!['POST','GET'].includes(method)) throw new RunError('method_denied');
diff --git a/tests/application.test.mjs b/tests/application.test.mjs
index 6283c14..7eb2357 100644
--- a/tests/application.test.mjs
+++ b/tests/application.test.mjs
@@ -168,3 +168,53 @@ test('HTTP ownership isolates two sessions across run reads, approvals, cancella
