+// Shared downstream selection. The enclosing cycle stays the authority; never
+// rewrite its nested review to masquerade as a legacy top-level result.
+import { successfulReview } from './review-coverage.mjs';
+import { validateCycleResult } from './cycle-result.mjs';
+import { cycleOperationId } from './cycle-plan.mjs';
+import { RunError } from './runs.mjs';
+export function selectedReview(run) {
+  if(!run.cycle){
+    if(!successfulReview(run.result)) throw new RunError('journey_review_unavailable');
+    return run.result;
+  }
+  const cycle=run.cycleResult;
+  if(!cycle) throw new RunError('journey_cycle_result_unavailable');
+  if(cycle.completion!=='complete'||cycle.failures?.length) throw new RunError('journey_cycle_failed');
+  if(!cycle.review) throw new RunError('journey_cycle_review_missing');
+  if(!cycle.execution) throw new RunError('journey_cycle_execution_unavailable');
+  try { validateCycleResult(run,cycle,run.mode==='local'?{gatewayLanes:run.gatewayLanes,operationId:cycleOperationId(run.agentId,run.id,run.cycle)}:{}); }
+  catch { throw new RunError('journey_cycle_identity_mismatch'); }
+  if(!successfulReview(cycle.review)) throw new RunError('journey_review_unavailable');
+  return cycle.review;
+}
+export function originalAgentReport(run) {
+  return {schema:'codefriend.local_agent.v1',agent_id:run.agentId,subject:run.subject,run_id:run.id,
+    consent_digest:run.consentDigest,execution_location:'local_agent',gateway_lanes:run.gatewayLanes,
+    status:'complete',expires_at:run.expiresAt,result:run.result,
+    ...(run.cycle?{cycle_result:run.cycleResult}:{}),digest:run.agentReportDigest};
+}
+
+export function reviewAvailable(run){try{return Boolean(selectedReview(run));}catch{return false;}}
