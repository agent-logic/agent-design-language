 });
+
+// PVF: deterministic authorization component proof; fixed clock, SQLite and
+// loopback HTTP. Existing runtime release gate; no provider or deployment proof.
+test('cycle review evidence proxy preserves reservation, cancellation and agent authority', async () => {
+  const { cycleOperationId } = await import('../app/cycle-plan.mjs');
+  const dir=mkdtempSync(join(tmpdir(),'review-proxy-')),store=new Store(join(dir,'db.sqlite'));
+  const origin='https://beta.example.test',clock=()=>1000,invited=async()=>true;
+  const credentials=new Credentials({store,invited,clock,path:join(dir,'credentials.json')});
+  const agents=new Agents({store,credentials,invited,origin,clock});
+  const calls=[];
+  const server=application({origin,store,agents,credentials,modelGateway:async(token,method,path)=>{calls.push({method,path});return {schema:'fixture.original_review',operation:path.split('/')[3]};}});
+  server.listen(0,'127.0.0.1');await once(server,'listening');
+  const base=`http://127.0.0.1:${server.address().port}`;
+  const pair=async()=>agents.pair({schema:'codefriend.local_agent.v1',code:(await agents.code('github_123')).code});
+  async function request(token,path,method='GET',body){
+    const r=await fetch(base+path,{method,headers:{Authorization:`Bearer ${token}`,'Content-Type':'application/json'},body:body===undefined?undefined:JSON.stringify(body)});
+    return {status:r.status,body:await r.json()};
+  }
+  try {
+    const owner=await pair(),other=await pair();
+    const poll={schema:owner.schema,agent_id:owner.agent_id,consent_digest:'a'.repeat(64)};
+    await agents.poll(owner.agent_token,poll);
+    const run=await agents.start(owner.subject,owner.agent_id,poll.consent_digest,1100,{repository:'https://github.com/agent-logic/codefriend.ai',activities:['review'],testing:null});
+    const command=(await agents.poll(owner.agent_token,poll)).command;
+    const op=cycleOperationId(owner.agent_id,run.id,run.cycle),path=`/v1/operations/${op}/review-evidence`;
+    assert.notEqual((await request(owner.model_token,path)).status,200); // Not reserved.
+    assert.equal(calls.length,0);
+    assert.equal((await request(owner.model_token,'/v1/operations','POST',{operation_id:op,mode:'local_model',lane:null,cycle:command.cycle,review_generation:command.review_generation})).status,200);
+    for(const status of ['running','complete']) {
+      store.update('run',run.id,owner.subject,r=>({...r,status}));
+      const response=await request(owner.model_token,path);
+      assert.equal(response.status,200);assert.equal(response.body.operation,op);
+    }
+    const count=calls.length;
+    for(const [token,target,method] of [[other.model_token,path,'GET'],[owner.agent_token,path,'GET'],[owner.model_token,path,'POST'],[owner.model_token,`/v1/operations/${run.id}/review-evidence`,'GET']]) {
+      assert.notEqual((await request(token,target,method)).status,200);
+    }
+    for(const status of ['cancel_requested','cancelled','expired','interrupted']) {
+      store.update('run',run.id,owner.subject,r=>({...r,status}));
+      assert.notEqual((await request(owner.model_token,path)).status,200);
+    }
+    store.update('run',run.id,owner.subject,r=>({...r,status:'complete',cancelRequested:true}));
+    assert.notEqual((await request(owner.model_token,path)).status,200);
+    store.update('run',run.id,owner.subject,r=>({...r,cancelRequested:false}));
+    await agents.revoke(owner.agent_token);
+    assert.notEqual((await request(owner.model_token,path)).status,200);
+    assert.equal(calls.length,count); // Denials never reach gateway.
+    assert.deepEqual(calls.slice(1),[{method:'GET',path},{method:'GET',path}]);
+  } finally {server.closeAllConnections();await new Promise(r=>server.close(r));store.close();rmSync(dir,{recursive:true,force:true});}
+});

