       assert.notEqual((await request(token,target,method)).status,200);
@@ -215,6 +225,6 @@ test('cycle review evidence proxy preserves reservation, cancellation and agent
     await agents.revoke(owner.agent_token);
     assert.notEqual((await request(owner.model_token,path)).status,200);
     assert.equal(calls.length,count); // Denials never reach gateway.
