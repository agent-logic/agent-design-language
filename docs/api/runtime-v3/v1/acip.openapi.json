{
  "openapi": "3.1.0",
  "info": {
    "title": "Agent Logic Runtime v3 ACIP/A2A",
    "version": "1.0.0",
    "description": "Companion view of the canonical /v1/acip/ws contract served from openapi.json. This document must not define a different frame protocol."
  },
  "paths": {
    "/v1/acip/ws": {
      "get": {
        "summary": "Open an authenticated bounded ACIP/A2A WebSocket session",
        "description": "Upgrades over ordinary server-authenticated TLS after exact Origin and Runtime API bearer checks. The server sends an authenticated JSON session frame. Every client work frame after upgrade is a bounded binary Protobuf envelope; text work frames are rejected. Dispatch remains subject to signed control authority, capability admission, runtime identity, replay identity, and monotonic sequence checks.",
        "security": [
          {
            "runtimeApiBearer": []
          }
        ],
        "responses": {
          "101": {
            "description": "WebSocket protocol upgrade"
          },
          "401": {
            "description": "Bearer authentication failed"
          },
          "403": {
            "description": "Origin, runtime, authority, or capability denied"
          },
          "426": {
            "description": "WebSocket upgrade required"
          }
        },
        "x-acip-protocol": {
          "family": "adl-acip-a2a",
          "major": 1,
          "minor": 0,
          "protobuf": "adl-runtime/schemas/acip/v1/acip.proto",
          "catalog": "adl-runtime/schemas/acip/v1/catalog.json",
          "maximumFrameBytes": 65536,
          "backpressure": "bounded-await-no-unbounded-queue",
          "reconnect": "renegotiate-and-use-new-replay-identities",
          "transport": {
            "scheme": "wss",
            "serverTls": "external-ca-platform-trusted",
            "listenerMutualTls": false
          },
          "admission": {
            "session": [
              "server-tls",
              "runtime-api-bearer",
              "exact-origin"
            ],
            "dispatch": [
              "negotiated-v1",
              "runtime-id",
              "signed-control",
              "capability",
              "authority",
              "replay-id",
              "monotonic-sequence",
              "frame-size"
            ]
          }
        },
        "x-adl-websocket": {
          "scheme": "wss",
          "maximumFrameBytes": 65536,
          "serverFirstFrame": {
            "$ref": "#/components/schemas/AuthenticatedFrame"
          },
          "clientFrames": [
            {
              "format": "binary",
              "schema": "adl.csm.acip_carrier.protobuf_envelope.v1"
            }
          ],
          "serverFrames": [
            {
              "$ref": "#/components/schemas/DispatchResult"
            }
          ],
          "policyCloseReasons": [
            "credential_revoked",
            "frame_size_refused",
            "binary_acip_frame_required",
            "invalid_acip_frame",
            "wrong_runtime",
            "unsigned_control_refused",
            "capability_denied",
            "authority_denied",
            "replay_refused"
          ]
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "runtimeApiBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Runtime API bearer credential supplied in the WebSocket upgrade request."
      }
    },
    "schemas": {
      "AuthenticatedFrame": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "event",
          "path",
          "bidirectional"
        ],
        "properties": {
          "schema": {
            "const": "adl.csm.runtime_api.wss_session.v1"
          },
          "event": {
            "const": "authenticated"
          },
          "path": {
            "const": "/v1/acip/ws"
          },
          "bidirectional": {
            "const": true
          }
        }
      },
      "DispatchResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "status",
          "sequence_reserved"
        ],
        "properties": {
          "schema": {
            "const": "adl.csm.acip_carrier.websocket_frame.v1"
          },
          "status": {
            "enum": [
              "completed",
              "rejected"
            ]
          },
          "message_id": {
            "type": "string"
          },
          "accepted_sequence": {
            "type": "integer",
            "minimum": 0
          },
          "result_hash": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "sequence_reserved": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
