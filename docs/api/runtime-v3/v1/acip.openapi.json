{
  "openapi": "3.1.0",
  "info": {
    "title": "Agent Logic Runtime v3 ACIP/A2A",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/acip/ws": {
      "get": {
        "summary": "Open an authenticated bounded ACIP/A2A WebSocket session",
        "description": "Requires TLS, an exact allowed Origin, Runtime API bearer authentication, v1 negotiation, signed control authority, capability admission, bounded frames, and unique replay identity before dispatch.",
        "security": [{ "runtimeApiBearer": [] }],
        "responses": {
          "101": { "description": "WebSocket protocol upgrade" },
          "401": { "description": "Authentication failed" },
          "403": { "description": "Origin, runtime, authority, or capability denied" },
          "426": { "description": "WebSocket upgrade required" }
        },
        "x-acip-protocol": {
          "family": "adl-acip-a2a",
          "major": 1,
          "minor": 0,
          "protobuf": "adl-runtime/schemas/acip/v1/acip.proto",
          "catalog": "adl-runtime/schemas/acip/v1/catalog.json",
          "maximumFrameBytes": 65536,
          "backpressure": "bounded-await-no-unbounded-queue",
          "reconnect": "renegotiate-and-use-new-replay-identities",
          "admission": {
            "session": ["tls", "runtime-api-bearer", "exact-origin"],
            "dispatch": [
              "negotiated-v1", "runtime-id", "signed-control", "capability",
              "authority", "replay-id", "monotonic-sequence", "frame-size"
            ]
          }
        },
        "x-adl-websocket": {
          "scheme": "wss",
          "textFramesOnly": true,
          "serverFirstFrame": { "$ref": "#/components/schemas/AuthenticatedFrame" },
          "clientFrames": [
            { "$ref": "#/components/schemas/NegotiationFrame" },
            { "$ref": "#/components/schemas/CarrierFrame" }
          ],
          "serverFrames": [
            { "$ref": "#/components/schemas/NegotiatedFrame" },
            { "$ref": "#/components/schemas/CarrierAckFrame" }
          ],
          "policyCloseReasons": [
            "credential_revoked", "frame_size_refused", "unsupported_frame",
            "invalid_json", "negotiation_refused", "negotiation_required",
            "invalid_acip_frame", "wrong_runtime", "unsigned_control_refused",
            "capability_denied", "authority_denied", "replay_refused"
          ]
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "runtimeApiBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "AuthenticatedFrame": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema", "event", "path", "bidirectional"],
        "properties": {
          "schema": { "const": "adl.csm.runtime_api.wss_session.v1" },
          "event": { "const": "authenticated" },
          "path": { "const": "/v1/acip/ws" },
          "bidirectional": { "const": true }
        }
      },
      "NegotiationFrame": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "body"],
        "properties": {
          "type": { "const": "negotiate" },
          "body": { "$ref": "#/components/schemas/NegotiationOffer" }
        }
      },
      "NegotiationOffer": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocol_family", "supported_major", "minimum_minor", "maximum_minor", "required_features"],
        "properties": {
          "protocol_family": { "const": "adl-acip-a2a" },
          "supported_major": { "const": 1 },
          "minimum_minor": { "type": "integer", "minimum": 0 },
          "maximum_minor": { "type": "integer", "minimum": 0 },
          "required_features": { "type": "array", "maxItems": 32, "items": { "type": "string" } }
        }
      },
      "NegotiatedFrame": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema", "type", "body"],
        "properties": {
          "schema": { "const": "adl.csm.runtime_api.wss_session.v1" },
          "type": { "const": "negotiated" },
          "body": {
            "type": "object",
            "additionalProperties": false,
            "required": ["protocol_family", "version_major", "version_minor", "features"],
            "properties": {
              "protocol_family": { "const": "adl-acip-a2a" },
              "version_major": { "const": 1 },
              "version_minor": { "const": 0 },
              "features": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      },
      "CarrierFrame": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "encoding", "correlation_id", "body"],
        "properties": {
          "type": { "const": "acip" },
          "encoding": { "enum": ["protobuf-base64", "deterministic-json"] },
          "correlation_id": { "type": "string", "minLength": 1 },
          "body": {},
          "control_signature": { "type": ["string", "null"] }
        }
      },
      "CarrierAckFrame": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema", "type", "body"],
        "properties": {
          "schema": { "const": "adl.csm.runtime_api.wss_session.v1" },
          "type": { "const": "ack" },
          "body": {
            "type": "object",
            "additionalProperties": false,
            "required": ["correlation_id", "encoding", "body"],
            "properties": {
              "correlation_id": { "type": "string", "minLength": 1 },
              "encoding": { "enum": ["protobuf-base64", "deterministic-json"] },
              "body": {}
            }
          }
        }
      },
      "EnvelopeJsonProjection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema", "protocol_family", "version_major", "version_minor",
          "message_id", "source", "target", "runtime_id", "route",
          "correlation_id", "causation_id", "trace_id", "replay_id",
          "capability", "authority", "payload_type", "payload_json",
          "monotonic_sequence", "acknowledgement_requested", "required_features"
        ],
        "properties": {
          "schema": { "const": "adl.csm.acip_carrier.protobuf_envelope.v1" },
          "protocol_family": { "const": "adl-acip-a2a" },
          "version_major": { "const": 1 },
          "version_minor": { "const": 0 },
          "message_id": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "runtime_id": { "type": "string", "minLength": 1 },
          "route": { "type": "string", "minLength": 1 },
          "correlation_id": { "type": "string", "minLength": 1 },
          "causation_id": { "type": "string", "minLength": 1 },
          "trace_id": { "type": "string", "minLength": 1 },
          "replay_id": { "type": "string", "minLength": 1 },
          "capability": { "type": "string", "minLength": 1 },
          "authority": { "type": "string", "minLength": 1 },
          "payload_type": { "type": "string", "minLength": 1 },
          "payload_json": { "type": "string" },
          "monotonic_sequence": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
          "acknowledgement_requested": { "type": "boolean" },
          "error_code": { "type": ["string", "null"] },
          "required_features": { "type": "array", "maxItems": 32, "items": { "type": "string" } }
        }
      }
    }
  }
}
