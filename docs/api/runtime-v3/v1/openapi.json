{
  "openapi": "3.1.0",
  "info": {
    "title": "ADL Runtime v3 Core API",
    "version": "1.0.0",
    "summary": "Control, status, telemetry, and agent communication",
    "description": "Use this API to inspect runtime health, read telemetry, send authenticated control commands, and exchange ACIP messages. The production Axum stack is owned by adl-runtime-kernel, and this document is the canonical ACIP/OpenAPI authority for the runtime."
  },
  "servers": [
    {
      "url": "{publicBaseUrl}",
      "description": "Runtime HTTPS base URL.",
      "variables": {
        "publicBaseUrl": {
          "default": "https://runtime.dev.agent-logic.ai:20997",
          "description": "Base URL for the runtime instance."
        }
      }
    }
  ],
  "tags": [
    {
      "name": "status",
      "description": "Public Runtime v3 health and telemetry reads."
    },
    {
      "name": "acip",
      "description": "Authenticated Runtime v3 ACIP bidirectional WebSocket carrier owned by adl-runtime-kernel."
    },
    {
      "name": "control",
      "description": "Signed Runtime v3 control commands."
    },
    {
      "name": "layer8",
      "description": "Layer 8 signed authority protocol endpoints."
    },
    {
      "name": "discovery",
      "description": "API specifications and interactive documentation."
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "readRuntimeHealth",
        "tags": [
          "status"
        ],
        "summary": "Read Runtime v3 capability health",
        "security": [],
        "responses": {
          "200": {
            "description": "Runtime v3 health report.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservatoryHealthFeed"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ready": {
      "get": {
        "operationId": "readRuntimeReadiness",
        "tags": [
          "status"
        ],
        "summary": "Read Runtime v3 readiness",
        "description": "Returns bounded readiness truth for operator and watcher probes. A stale weather sample is reported as degraded readiness instead of being hidden behind a green top-line health result.",
        "security": [],
        "responses": {
          "200": {
            "description": "Runtime v3 is ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeReadinessReport"
                }
              }
            }
          },
          "503": {
            "description": "Runtime v3 is reachable but degraded or not ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeReadinessReport"
                }
              }
            }
          }
        }
      },
      "options": {
        "operationId": "runtimeReadinessCorsPreflight",
        "tags": [
          "status"
        ],
        "summary": "Preflight Runtime v3 readiness reads from the HTML Observatory",
        "description": "Returns CORS preflight headers for configured Observatory origins before browser reads of /v1/ready.",
        "security": [],
        "responses": {
          "204": {
            "description": "Origin and requested method are allowed for the readiness probe."
          },
          "403": {
            "description": "Origin is not present in configured observatory.allowed_origins."
          }
        }
      }
    },
    "/v1/metrics": {
      "get": {
        "operationId": "readRuntimeMetrics",
        "tags": [
          "status"
        ],
        "summary": "Read Runtime v3 telemetry sink configuration",
        "security": [],
        "responses": {
          "200": {
            "description": "Runtime v3 telemetry sink configuration.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservabilityPipelineSnapshot"
                }
              }
            }
          }
        }
      }
    },
    "/v1/acip/ws": {
      "get": {
        "operationId": "openAcipWebSocket",
        "tags": [
          "acip"
        ],
        "summary": "Open the authenticated bidirectional ACIP WebSocket carrier",
        "description": "Upgrades over ordinary server-authenticated TLS after bearer authentication. The server sends an authenticated JSON session frame, accepts bounded ACIP Protobuf binary envelopes, dispatches each envelope through canonical ingress, and returns a structured JSON completion or rejection frame. Replay sequence state is isolated by the authenticated credential and the envelope runtime/source domain; zero, terminal, replayed, and excessive sequence advances are rejected without reserving the sequence. Canonical-ingress pressure is reported as a structured rejection. This is the one canonical production ACIP WebSocket endpoint, and it is owned by adl-runtime-kernel.",
        "security": [
          {
            "acipWriteBearer": []
          }
        ],
        "responses": {
          "101": {
            "description": "WebSocket upgrade accepted."
          },
          "401": {
            "$ref": "#/components/responses/RuntimeAuthenticationFailed"
          }
        },
        "x-adl-websocket": {
          "scheme": "wss",
          "maxFrameBytes": 65536,
          "authentication": "http_bearer_upgrade_header",
          "serverTls": "external-ca-platform-trusted",
          "listenerMutualTls": false,
          "serverFirstFrame": {
            "$ref": "#/components/schemas/AcipAuthenticatedFrame"
          },
          "clientFrames": [
            {
              "binarySchema": "adl.csm.acip_carrier.protobuf_envelope.v1",
              "maxBytes": 65536
            }
          ],
          "serverFrames": [
            {
              "$ref": "#/components/schemas/AcipDispatchResult"
            }
          ],
          "policyCloseReasons": [
            "credential_revoked",
            "binary_acip_frame_required"
          ],
          "bidirectional": true,
          "canonicalEndpoint": true,
          "serviceOwner": "adl-runtime-kernel",
          "replayScope": "authenticated_principal_runtime_source",
          "maximumSequenceAdvance": 1000000,
          "terminalSequenceAccepted": false,
          "pressureResult": "structured_rejection_without_sequence_reservation"
        }
      }
    },
    "/v1/layer8/recipient-acknowledgement": {
      "post": {
        "operationId": "verifyLayer8RecipientAcknowledgement",
        "tags": [
          "layer8"
        ],
        "summary": "Verify a signed Layer 8 recipient acknowledgement",
        "description": "Verifies the sender-signed request and recipient-signed acknowledgement before reporting delivery. The route performs no conversation-history, Observatory, or durable-state mutation, binds credential generations through the signed identity messages, distinguishes delivered from refused acknowledgements, and returns only a hash of the shared correlation id.",
        "security": [],
        "x-adl-authorization": {
          "transport": "server_tls",
          "listenerMutualTls": false,
          "application": "sender_request_and_recipient_acknowledgement_ed25519_signatures",
          "verifyBeforeSideEffects": true,
          "correlation": "hash_only",
          "description": "The Runtime validates both SignedIdentityMessage signatures after ordinary server-authenticated TLS. This endpoint does not invent authority, expose raw correlation ids, or persist delivery history."
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RuntimeRecipientAcknowledgementRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Acknowledgement verified and delivered.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeRecipientAcknowledgementResponse"
                }
              }
            }
          },
          "400": {
            "description": "Request or acknowledgement refused before side effects.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeRecipientAcknowledgementResponse"
                }
              }
            }
          },
          "503": {
            "description": "Layer 8 acknowledgement verifier is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeRecipientAcknowledgementResponse"
                }
              }
            }
          }
        }
      },
      "options": {
        "operationId": "runtimeLayer8RecipientAcknowledgementCorsPreflight",
        "tags": [
          "layer8"
        ],
        "summary": "Preflight Layer 8 recipient acknowledgement verification",
        "description": "Returns CORS preflight headers for configured Observatory origins before browser POSTs to /v1/layer8/recipient-acknowledgement.",
        "security": [],
        "responses": {
          "204": {
            "description": "Origin and requested method are allowed for signed acknowledgement verification."
          },
          "403": {
            "description": "Origin is not present in configured observatory.allowed_origins."
          }
        }
      }
    },
    "/v1/control": {
      "post": {
        "operationId": "runtimeControlCommand",
        "tags": [
          "control"
        ],
        "summary": "Submit a signed Runtime v3 control command",
        "description": "Executes a signed Ed25519 control command against the current runtime instance. The action may read a snapshot, submit canonical work through live ingress, request shutdown, or request an incarnation-bound Guardian restart according to the key capability set. Browser callers receive CORS headers only when their Origin is listed in the Runtime v3 Observatory allowed-origin policy.",
        "security": [],
        "x-adl-authorization": {
          "transport": "server_tls",
          "listenerMutualTls": false,
          "application": "ed25519_signed_request_body",
          "description": "The Runtime validates SignedControlCommand after ordinary server-authenticated TLS. Signed-command authorization is not mutual TLS, and ACIP write authority uses a distinct bearer credential from Observatory read access."
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignedControlCommand"
              },
              "examples": {
                "snapshot": {
                  "value": {
                    "schema": "adl.runtime.control_command.v1",
                    "runtime_instance_id": "runtime0001",
                    "command_id": "cmd0001",
                    "correlation_id": "corr-0001",
                    "principal": "operator",
                    "action": {
                      "action": "snapshot"
                    },
                    "signing_algorithm": "ed25519",
                    "signing_key_id": "operator-key",
                    "signature": "00"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Command accepted and executed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ControlResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/ControlAuthenticationFailed"
          },
          "403": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/IdempotencyConflict"
          },
          "410": {
            "$ref": "#/components/responses/StaleRuntimeInstance"
          },
          "503": {
            "$ref": "#/components/responses/TemporarilyUnavailable"
          }
        }
      },
      "options": {
        "operationId": "runtimeControlCorsPreflight",
        "tags": [
          "control"
        ],
        "summary": "Preflight Runtime v3 signed control commands from the HTML Observatory",
        "description": "Returns CORS preflight headers for configured Observatory origins before browser POSTs to /v1/control.",
        "security": [],
        "responses": {
          "204": {
            "description": "Origin and requested method are allowed for signed browser control commands."
          },
          "403": {
            "description": "Origin is not present in configured observatory.allowed_origins."
          }
        }
      }
    },
    "/v1/openapi.json": {
      "get": {
        "operationId": "readRuntimeCoreOpenApi",
        "tags": [
          "discovery"
        ],
        "summary": "Read the Runtime Core OpenAPI document",
        "description": "Returns the Runtime Core OpenAPI 3.1 document for client generation.",
        "responses": {
          "200": {
            "description": "Runtime Core OpenAPI document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/observatory/openapi.json": {
      "get": {
        "operationId": "readObservatoryOpenApi",
        "tags": [
          "discovery"
        ],
        "summary": "Read the Observatory OpenAPI document",
        "description": "Returns the Observatory OpenAPI 3.1 document for client generation.",
        "responses": {
          "200": {
            "description": "Observatory OpenAPI document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/docs/": {
      "get": {
        "operationId": "readRuntimeApiDocs",
        "tags": [
          "discovery"
        ],
        "summary": "Open the Runtime API documentation",
        "description": "Provides interactive documentation for the Runtime Core and Observatory APIs.",
        "responses": {
          "200": {
            "description": "Browsable API documentation.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v1/observatory/docs/": {
      "get": {
        "operationId": "readObservatoryApiDocs",
        "tags": [
          "discovery"
        ],
        "summary": "Open the Observatory API documentation",
        "description": "Provides interactive documentation for the Observatory API.",
        "responses": {
          "200": {
            "description": "Browsable Observatory API documentation.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "acipWriteBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Distinct ACIP write bearer credential configured outside code through Runtime v3 init/environment. Observatory read credentials do not authorize ACIP writes."
      }
    },
    "responses": {
      "RuntimeAuthenticationFailed": {
        "description": "Missing, malformed, incorrect, or unavailable ACIP write bearer credential.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ControlError"
            }
          }
        }
      },
      "InvalidRequest": {
        "description": "Invalid request encoding, identifier, bounds, schema, or signature shape.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ControlError"
            }
          }
        }
      },
      "ControlAuthenticationFailed": {
        "description": "Control command authentication failed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ControlError"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Authenticated principal lacks the required control capability.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ControlError"
            }
          }
        }
      },
      "IdempotencyConflict": {
        "description": "Command id conflict, in-flight duplicate, or duplicate terminal lifecycle request.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ControlError"
            }
          }
        }
      },
      "StaleRuntimeInstance": {
        "description": "The command targets a stale runtime instance id.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ControlError"
            }
          }
        }
      },
      "TemporarilyUnavailable": {
        "description": "Runtime admission is closed, saturated, or temporarily unavailable.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ControlError"
            }
          }
        }
      }
    },
    "schemas": {
      "RuntimeHealthState": {
        "enum": [
          "unimplemented",
          "unavailable",
          "failed",
          "healthy"
        ]
      },
      "RuntimeCapabilityHealth": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "state",
          "reason_code",
          "evidence_ref"
        ],
        "properties": {
          "capability": {
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/RuntimeHealthState"
          },
          "reason_code": {
            "type": "string"
          },
          "evidence_ref": {
            "type": "string"
          }
        }
      },
      "RuntimeHealthReport": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "runtime_owner",
          "capabilities"
        ],
        "properties": {
          "schema": {
            "const": "adl.csm.runtime_api.health.v1"
          },
          "runtime_owner": {
            "type": "string"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RuntimeCapabilityHealth"
            }
          }
        }
      },
      "RuntimeTelemetrySink": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sink",
          "supported_fields"
        ],
        "properties": {
          "sink": {
            "type": "string"
          },
          "supported_fields": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      },
      "RuntimeTelemetryConfig": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "sinks"
        ],
        "properties": {
          "schema": {
            "const": "adl.csm.runtime_api.metrics.v1"
          },
          "sinks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RuntimeTelemetrySink"
            }
          }
        }
      },
      "RuntimeFeatureMatrixRow": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature",
          "adapter",
          "claimed",
          "health_state",
          "proof"
        ],
        "properties": {
          "feature": {
            "type": "string"
          },
          "adapter": {
            "type": "string"
          },
          "claimed": {
            "type": "boolean"
          },
          "health_state": {
            "$ref": "#/components/schemas/RuntimeHealthState"
          },
          "proof": {
            "type": "string"
          }
        }
      },
      "RuntimeFeatureMatrix": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "unresolved_claimed_features",
          "rows"
        ],
        "properties": {
          "schema": {
            "const": "adl.csm.runtime_api.feature_matrix.v1"
          },
          "unresolved_claimed_features": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string"
            }
          },
          "rows": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "$ref": "#/components/schemas/RuntimeFeatureMatrixRow"
            }
          }
        }
      },
      "AcipAuthenticatedFrame": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "event",
          "path",
          "bidirectional"
        ],
        "properties": {
          "schema": {
            "const": "adl.csm.acip_carrier.websocket_frame.v1"
          },
          "event": {
            "const": "authenticated"
          },
          "path": {
            "const": "/v1/acip/ws"
          },
          "bidirectional": {
            "const": true
          }
        }
      },
      "AcipDispatchResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema", "status", "sequence_reserved"],
        "properties": {
          "schema": {
            "const": "adl.csm.acip_carrier.websocket_frame.v1"
          },
          "status": {
            "enum": ["completed", "rejected"]
          },
          "message_id": {
            "type": "string"
          },
          "accepted_sequence": {
            "type": "integer",
            "minimum": 0
          },
          "result_hash": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "sequence_reserved": {
            "type": "boolean"
          }
        }
      },
      "SignedIdentityMessage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "message_kind",
          "message_id",
          "sender_id",
          "recipient_id",
          "polis_id",
          "conversation_id",
          "correlation_id",
          "causation_id",
          "replay_id",
          "monotonic_sequence",
          "issued_at_epoch_secs",
          "expires_at_epoch_secs",
          "payload_json",
          "signing_key_id",
          "credential_generation",
          "signature"
        ],
        "properties": {
          "schema": {
            "const": "adl.runtime.acip.identity_message.v1"
          },
          "message_kind": {
            "enum": ["request", "acknowledgement"]
          },
          "message_id": {
            "type": "string"
          },
          "sender_id": {
            "type": "string"
          },
          "recipient_id": {
            "type": "string"
          },
          "polis_id": {
            "type": "string"
          },
          "conversation_id": {
            "type": "string"
          },
          "correlation_id": {
            "type": "string",
            "description": "Raw signed correlation id. The acknowledgement response returns only correlation_hash."
          },
          "causation_id": {
            "type": "string"
          },
          "replay_id": {
            "type": "string"
          },
          "monotonic_sequence": {
            "type": "integer",
            "minimum": 1
          },
          "issued_at_epoch_secs": {
            "type": "integer",
            "minimum": 0
          },
          "expires_at_epoch_secs": {
            "type": "integer",
            "minimum": 1
          },
          "payload_json": {
            "type": "string",
            "description": "JCS-canonical JSON string covered by the Ed25519 signature."
          },
          "signing_key_id": {
            "type": "string"
          },
          "credential_generation": {
            "type": "integer",
            "minimum": 1
          },
          "signature": {
            "type": "string",
            "description": "Hex-encoded Ed25519 signature over the unsigned identity message JSON."
          }
        }
      },
      "RuntimeRecipientAcknowledgementRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema", "signed_request", "acknowledgement"],
        "properties": {
          "schema": {
            "const": "adl.runtime_v3.layer8.recipient_acknowledgement_request.v1"
          },
          "signed_request": {
            "$ref": "#/components/schemas/SignedIdentityMessage"
          },
          "acknowledgement": {
            "$ref": "#/components/schemas/SignedIdentityMessage"
          }
        }
      },
      "RuntimeRecipientAcknowledgementResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema", "status"],
        "properties": {
          "schema": {
            "const": "adl.runtime_v3.layer8.recipient_acknowledgement_response.v1"
          },
          "status": {
            "enum": ["delivered", "refused", "failed"]
          },
          "conversation_id": {
            "type": "string"
          },
          "request_message_id": {
            "type": "string"
          },
          "acknowledgement_message_id": {
            "type": "string"
          },
          "sender_id": {
            "type": "string"
          },
          "recipient_id": {
            "type": "string"
          },
          "correlation_hash": {
            "type": "string",
            "description": "BLAKE3 hash of the raw signed correlation id; the raw correlation id is not echoed."
          },
          "sender_credential_generation": {
            "type": "integer",
            "minimum": 1
          },
          "recipient_credential_generation": {
            "type": "integer",
            "minimum": 1
          },
          "error": {
            "type": "string"
          }
        }
      },
      "SignedControlCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "runtime_instance_id",
          "command_id",
          "correlation_id",
          "principal",
          "action",
          "signing_algorithm",
          "signing_key_id",
          "signature"
        ],
        "properties": {
          "schema": {
            "const": "adl.runtime.control_command.v1"
          },
          "runtime_instance_id": {
            "type": "string"
          },
          "command_id": {
            "type": "string"
          },
          "correlation_id": {
            "type": "string"
          },
          "principal": {
            "type": "string"
          },
          "action": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ControlActionSnapshot"
              },
              {
                "$ref": "#/components/schemas/ControlActionSubmit"
              },
              {
                "$ref": "#/components/schemas/ControlActionShutdown"
              },
              {
                "$ref": "#/components/schemas/ControlActionRestart"
              }
            ]
          },
          "signing_algorithm": {
            "const": "ed25519"
          },
          "signing_key_id": {
            "type": "string"
          },
          "signature": {
            "type": "string",
            "description": "Hex-encoded Ed25519 signature over the unsigned command JSON."
          }
        }
      },
      "ControlActionSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "const": "snapshot"
          }
        }
      },
      "ControlActionSubmit": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "work"
        ],
        "properties": {
          "action": {
            "const": "submit"
          },
          "work": {
            "$ref": "#/components/schemas/DomainWork"
          }
        }
      },
      "ControlActionShutdown": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "grace_millis"
        ],
        "properties": {
          "action": {
            "const": "shutdown"
          },
          "grace_millis": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60000
          }
        }
      },
      "ControlActionRestart": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "expected_incarnation_id", "grace_millis"],
        "properties": {
          "action": { "const": "restart" },
          "expected_incarnation_id": { "type": "string", "format": "uuid" },
          "grace_millis": { "type": "integer", "minimum": 1, "maximum": 60000 }
        }
      },
      "DomainWork": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "work_id",
          "kind",
          "payload"
        ],
        "properties": {
          "schema": {
            "const": "adl.runtime.domain_work.v1"
          },
          "work_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "description": "Runtime-supported canonical ingress work kind."
          },
          "payload": {
            "type": "array",
            "maxItems": 65536,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        }
      },
      "ControlResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "command_id",
          "correlation_id",
          "outcome"
        ],
        "properties": {
          "schema": {
            "const": "adl.runtime.control_response.v1"
          },
          "command_id": {
            "type": "string"
          },
          "correlation_id": {
            "type": "string"
          },
          "outcome": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ControlOutcomeSnapshot"
              },
              {
                "$ref": "#/components/schemas/ControlOutcomeSubmitted"
              },
              {
                "$ref": "#/components/schemas/ControlOutcomeShutdown"
              },
              {
                "$ref": "#/components/schemas/ControlOutcomeRestart"
              }
            ]
          }
        }
      },
      "ControlOutcomeSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "result",
          "snapshot"
        ],
        "properties": {
          "result": {
            "const": "snapshot"
          },
          "snapshot": {
            "$ref": "#/components/schemas/RuntimeSnapshot"
          }
        }
      },
      "ControlOutcomeSubmitted": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "result",
          "work_result"
        ],
        "properties": {
          "result": {
            "const": "submitted"
          },
          "work_result": {
            "$ref": "#/components/schemas/DomainResult"
          }
        }
      },
      "ControlOutcomeShutdown": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "result",
          "exit"
        ],
        "properties": {
          "result": {
            "const": "shutdown"
          },
          "exit": {
            "enum": [
              "clean",
              "failed"
            ]
          }
        }
      },
      "ControlOutcomeRestart": {
        "type": "object",
        "additionalProperties": false,
        "required": ["result", "accepted"],
        "properties": {
          "result": { "const": "restart" },
          "accepted": { "const": true }
        }
      },
      "DomainResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema", "work_id", "accepted_sequence", "result_hash"],
        "properties": {
          "schema": {
            "const": "adl.runtime.domain_result.v1"
          },
          "work_id": {
            "type": "string"
          },
          "accepted_sequence": {
            "type": "integer",
            "minimum": 0
          },
          "result_hash": {
            "type": "string"
          }
        }
      },
      "QueueHealth": {
        "type": "object",
        "additionalProperties": false,
        "required": ["generation", "capacity", "depth", "high_water", "sent", "rejected"],
        "properties": {
          "generation": { "type": "integer", "minimum": 0 },
          "capacity": { "type": "integer", "minimum": 0 },
          "depth": { "type": "integer", "minimum": 0 },
          "high_water": { "type": "integer", "minimum": 0 },
          "sent": { "type": "integer", "minimum": 0 },
          "rejected": { "type": "integer", "minimum": 0 }
        }
      },
      "ContinuityHead": {
        "type": "object",
        "additionalProperties": false,
        "required": ["generation", "accepted_through", "topology_hash", "config_hash", "integrity"],
        "properties": {
          "generation": { "type": "integer", "minimum": 0 },
          "accepted_through": { "type": "integer", "minimum": 0 },
          "topology_hash": { "type": "string" },
          "config_hash": { "type": "string" },
          "integrity": { "type": "string" }
        }
      },
      "ClockAuthority": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "reason"],
            "properties": {
              "status": { "const": "degraded" },
              "reason": { "type": "string" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "source", "unix_millis"],
            "properties": {
              "status": { "const": "authoritative" },
              "source": { "type": "string" },
              "unix_millis": { "type": "integer", "minimum": 0 }
            }
          }
        ]
      },
      "ObservabilityHealth": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "properties": { "status": { "enum": ["pending", "ready"] } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "reason"],
            "properties": {
              "status": { "const": "degraded" },
              "reason": { "enum": ["exporter_unavailable", "exporter_rejected"] }
            }
          }
        ]
      },
      "ObservabilityPipelineSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "health",
          "runtime_instance_id",
          "vector_pid",
          "vector_version",
          "master_log_ref",
          "log_audit_ref",
          "otlp_endpoint",
          "otlp_timeout_millis",
          "sequence_next",
          "drain_complete",
          "last_failure"
        ],
        "properties": {
          "schema": { "type": "string" },
          "health": { "$ref": "#/components/schemas/ObservabilityHealth" },
          "runtime_instance_id": { "type": "string" },
          "vector_pid": { "type": ["integer", "null"], "minimum": 0 },
          "vector_version": { "type": "string" },
          "master_log_ref": { "type": "string" },
          "log_audit_ref": { "type": "string" },
          "otlp_endpoint": { "type": ["string", "null"] },
          "otlp_timeout_millis": { "type": "integer", "minimum": 1 },
          "sequence_next": { "type": "integer", "minimum": 0 },
          "drain_complete": { "type": "boolean" },
          "last_failure": { "type": ["string", "null"] }
        }
      },
      "RuntimeSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "revision",
          "topology_generation",
          "components",
          "restart_counts",
          "queues",
          "clock",
          "continuity_head",
          "lifecycle",
          "event_count",
          "observability",
          "observability_ready",
          "observability_pipeline"
        ],
        "properties": {
          "schema": { "const": "adl.runtime.control_snapshot.v1" },
          "revision": { "type": "integer", "minimum": 0 },
          "topology_generation": { "type": "integer", "minimum": 0 },
          "components": {
            "type": "object",
            "additionalProperties": {
              "enum": ["starting", "ready", "running", "restarting", "degraded", "stopping", "stopped", "failed"]
            }
          },
          "restart_counts": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 }
          },
          "queues": {
            "type": "object",
            "additionalProperties": { "$ref": "#/components/schemas/QueueHealth" }
          },
          "clock": { "$ref": "#/components/schemas/ClockAuthority" },
          "continuity_head": {
            "oneOf": [
              { "$ref": "#/components/schemas/ContinuityHead" },
              { "type": "null" }
            ]
          },
          "lifecycle": {
            "enum": ["starting", "running", "stopping", "stopped", "failed"]
          },
          "event_count": { "type": "integer", "minimum": 0 },
          "observability": { "$ref": "#/components/schemas/ObservabilityHealth" },
          "observability_ready": { "type": "boolean" },
          "observability_pipeline": {
            "oneOf": [
              { "$ref": "#/components/schemas/ObservabilityPipelineSnapshot" },
              { "type": "null" }
            ]
          }
        }
      },
      "ObservatoryHealthFeed": {
        "type": "object",
        "additionalProperties": false,
        "required": ["snapshot", "observability_ready"],
        "properties": {
          "snapshot": { "$ref": "#/components/schemas/RuntimeSnapshot" },
          "observability_ready": { "type": "boolean" }
        }
      },
      "ObservatoryWeatherFreshness": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observed_at_unix_millis",
          "age_millis",
          "stale_after_millis",
          "stale"
        ],
        "properties": {
          "observed_at_unix_millis": { "type": "integer", "minimum": 0 },
          "age_millis": { "type": "integer", "minimum": 0 },
          "stale_after_millis": { "type": "integer", "minimum": 0 },
          "stale": { "type": "boolean" }
        }
      },
      "RuntimeReadinessReport": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "ready",
          "lifecycle",
          "observability_ready",
          "runtime_instance_id",
          "runtime_process_id",
          "weather_freshness",
          "degraded_reasons"
        ],
        "properties": {
          "schema": { "const": "adl.runtime_v3.readiness.v1" },
          "ready": { "type": "boolean" },
          "lifecycle": { "type": "string" },
          "observability_ready": { "type": "boolean" },
          "runtime_instance_id": { "type": "string" },
          "runtime_process_id": { "type": "integer", "minimum": 0 },
          "weather_freshness": {
            "oneOf": [
              { "$ref": "#/components/schemas/ObservatoryWeatherFreshness" },
              { "type": "null" }
            ]
          },
          "degraded_reasons": {
            "type": "array",
            "items": {
              "enum": [
                "observability_not_ready",
                "weather_stale"
              ]
            }
          }
        }
      },
      "ControlError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "code"
        ],
        "properties": {
          "schema": {
            "const": "adl.runtime.control_error.v1"
          },
          "code": {
            "enum": [
              "authentication_failed",
              "unauthorized",
              "idempotency_conflict",
              "temporarily_unavailable",
              "stale_runtime_instance",
              "invalid_request"
            ]
          }
        }
      }
    }
  },
  "x-adl-api-identity": "runtime-core",
  "x-adl-api-version": "v1",
  "x-adl-non-claims": [
    "No standalone HTTP provider, A2A, cloud bridge, checkpoint, scheduler, cancellation, continuity, trusted-time, or discovery path is documented as operational unless a real Axum route exists.",
    "No fixture, degraded, simulated, or unavailable feature is documented as operational."
  ]
}
